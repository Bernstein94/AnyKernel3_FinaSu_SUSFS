-    echo "已修复 setuid_hook.c 重复定义问题"
+    echo "已修复 setuid_hook.c 重复定义问题（KSU 变体: ${KSU_VARIANT:-未知}）"
   fi
 fi
+
+# 守护：主补丁若再次因上下文漂移漏掉 susfs_def.h，在这里给出可读错误，
+# 而不是等到编译 fs/proc/task_mmu.c 时才报一串 SUSFS_IS_INODE_* 隐式声明
+for SUSFS_SRC in fs/proc/task_mmu.c fs/namespace.c; do
+  [[ -f "$SUSFS_SRC" ]] || continue
+  if grep -qE 'SUSFS_IS_INODE_|CL_COPY_MNT_NS' "$SUSFS_SRC" \
+    && ! grep -qF '#include <linux/susfs_def.h>' "$SUSFS_SRC"; then
+    echo "::error::$SUSFS_SRC 使用了 SUSFS 宏但缺少 linux/susfs_def.h，主补丁 hunk 未应用"
+    exit 1
+  fi
+done
diff --git a/scripts/susfs_fixes/apply_kernelsu_susfs.py b/scripts/susfs_fixes/apply_kernelsu_susfs.py
new file mode 100644
index 0000000..51ac46a
--- /dev/null
+++ b/scripts/susfs_fixes/apply_kernelsu_susfs.py
@@ -0,0 +1,229 @@
+#!/usr/bin/env python3
+"""为原生 KernelSU (tiann/KernelSU) 添加 SUSFS 支持。
+
+tiann/KernelSU 结构可能随提交而变化：
+- kernel/core/init.c: 包含 kernelsu_init() 函数
+- kernel/Kconfig: 菜单定义
+- kernel/Kbuild: 编译单元
+
+simonpunk/susfs4ksu 的补丁针对 flat kernel/ksu.c，与 tiann/KernelSU 结构不匹配，
+故直接修改源码。如果无法自动集成，则返回非零退出码以便上层回退到手工 sed。
+"""
+
+import sys
+from pathlib import Path
+
+KSU_KERNEL = Path("KernelSU/kernel")
+
+
+def modify_kconfig():
+    """在 Kconfig 中添加完整的 KSU_SUSFS 菜单"""
+    kconfig = KSU_KERNEL / "Kconfig"
+    if not kconfig.exists():
+        print(f"WARNING: {kconfig} not found, skipping SUSFS menu for KernelSU", file=sys.stderr)
+        return False
+    s = kconfig.read_text(encoding="utf-8")
+    if "config KSU_SUSFS" in s:
+        print("Kconfig: SUSFS menu already present")
+        return True
+    marker = "endmenu\n"
+    insertion = (
+        'menu "KernelSU - SUSFS"\n'
+        'config KSU_SUSFS\n'
+        '\tbool "KernelSU addon - SUSFS"\n'
+        '\tdepends on KSU\n'
+        '\tdefault y\n'
+        '\thelp\n'
+        '\t  Patch and Enable SUSFS to kernel with KernelSU\n'
+        '\n'
+        'config KSU_SUSFS_SUS_PATH\n'
+        '\tbool "Enable to hide suspicious path"\n'
+        '\tdepends on KSU_SUSFS\n'
+        '\tdefault y\n'
+        '\n'
+        'config KSU_SUSFS_SUS_MOUNT\n'
+        '\tbool "Enable to hide suspicious mounts"\n'
+        '\tdepends on KSU_SUSFS\n'
+        '\tdefault y\n'
+        '\n'
+        'config KSU_SUSFS_SUS_KSTAT\n'
+        '\tbool "Enable to spoof suspicious kstat"\n'
+        '\tdepends on KSU_SUSFS\n'
+        '\tdefault y\n'
+        '\n'
+        'config KSU_SUSFS_SPOOF_UNAME\n'
+        '\tbool "Enable to spoof uname"\n'
+        '\tdepends on KSU_SUSFS\n'
+        '\tdefault y\n'
+        '\n'
+        'config KSU_SUSFS_ENABLE_LOG\n'
+        '\tbool "Enable logging susfs log to kernel"\n'
+        '\tdepends on KSU_SUSFS\n'
+        '\tdefault y\n'
+        '\n'
+        'config KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS\n'
+        '\tbool "Hide KSU SUSFS symbols"\n'
+        '\tdepends on KSU_SUSFS\n'
+        '\tdefault y\n'
+        '\n'
+        'config KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG\n'
+        '\tbool "Spoof cmdline or bootconfig"\n'
+        '\tdepends on KSU_SUSFS\n'
+        '\tdefault y\n'
+        '\n'
+        'config KSU_SUSFS_SUS_MAP\n'
+        '\tbool "Enable SUS_MAP"\n'
+        '\tdepends on KSU_SUSFS\n'
+        '\tdefault y\n'
+        '\n'
+        'config KSU_SUSFS_OPEN_REDIRECT\n'
+        '\tbool "Enable open redirect"\n'
+        '\tdepends on KSU_SUSFS\n'
+        '\tdefault y\n'
+        '\n'
+        'config KSU_SUSFS_PRIORITY_UID_FILTER\n'
+        '\tbool "Enable priority UID filter"\n'
+        '\tdepends on KSU_SUSFS\n'
+        '\tdefault y\n'
+        'endmenu\n'
+    )
+    idx = s.find(marker)
+    if idx < 0:
+        # 尝试其他 endmenu 变体
+        for m in ("endmenu\r\n", "endmenu"):
+            idx = s.find(m)
+            if idx >= 0:
+                break
+        if idx < 0:
+            print("WARNING: endmenu not found in Kconfig, skipping SUSFS menu", file=sys.stderr)
+            return False
+    s = s[:idx] + insertion + s[idx:]
+    kconfig.write_text(s, encoding="utf-8")
+    print("Kconfig: SUSFS menu added with all config options")
+    return True
+
+
+def modify_init_c():
+    """在 init.c 中添加 SUSFS 支持"""
+    init_c = KSU_KERNEL / "core" / "init.c"
+    if not init_c.exists():
+        print(f"ERROR: {init_c} not found, cannot integrate SUSFS for KernelSU", file=sys.stderr)
+        return False
+    s = init_c.read_text(encoding="utf-8")
+    changed = False
+
+    # 步骤1：添加 #include <linux/susfs.h>
+    # 尝试多个可能的调度头文件锚点
+    include_added = False
+    for marker in ("#include <linux/sched.h>", "#include <linux/sched/task.h>",
+                   "#include <linux/sched/signal.h>", "#include <linux/sched/wake_q.h>"):
+        if "#include <linux/susfs.h>" in s:
+            include_added = True
+            break
+        if marker in s:
+            s = s.replace(marker, marker + "\n#include <linux/susfs.h>", 1)
+            include_added = True
+            print(f"init.c: 添加 #include <linux/susfs.h> 在 {marker} 之后")
+            changed = True
+            break
+    if not include_added and "#include <linux/susfs.h>" not in s:
+        print("WARNING: 未找到适合的调度头文件锚点，跳过 #include <linux/susfs.h> 插入", file=sys.stderr)
+
+    # 步骤2：移除 ksu_syscall_hook_manager_init() / ksu_syscall_hook_init()
+    for hook_call in ("ksu_syscall_hook_manager_init();", "ksu_syscall_hook_init();",
+                      "ksu_syscall_hook_manager_init ();", "ksu_syscall_hook_init ();"):
+        count_before = s.count(hook_call)
+        if count_before > 0:
+            replacement = (
+                "#if defined(CONFIG_KSU_SUSFS)\n"
+                "    susfs_init();\n"
+                "    #endif"
+            )
+            s = s.replace(hook_call, replacement)
+            print(f"init.c: 替换 {count_before} 处 {hook_call}", file=sys.stderr)
+            changed = True
+
+    # 步骤3：如果仍未找到 susfs_init()，在 kernelsu_init() 函数体内插入
+    if "susfs_init()" not in s:
+        # 尝试多个函数名模式
+        func_found = False
+        for func_pattern in ("kernelsu_init(", "ksu_init(", "init_kernelsu("):
+            idx = s.find(func_pattern)
+            if idx >= 0:
+                func_found = True
+                ret_idx = s.find("return 0;", idx)
+                if ret_idx >= 0:
+                    insertion = (
+                        "\n    #ifdef CONFIG_KSU_SUSFS\n"
+                        "    susfs_init();\n"
+                        "    #endif\n"
+                    )
+                    s = s[:ret_idx] + insertion + s[ret_idx:]
+                    changed = True
+                    print("init.c: 在 kernelsu_init() 中插入 susfs_init()", file=sys.stderr)
+                else:
+                    print("WARNING: 未找到 kernelsu_init() 中的 return 0;，跳过 susfs_init() 插入", file=sys.stderr)
+                break
+        if not func_found:
+            print("WARNING: 未找到 kernelsu_init() 函数，跳过 susfs_init() 插入", file=sys.stderr)
+
+    if changed:
+        init_c.write_text(s, encoding="utf-8")
+        print("init.c: SUSFS support added")
+        return True
+    elif "susfs_init()" in s and "#include <linux/susfs.h>" in s:
+        print("init.c: SUSFS support already present")
+        return True
+    else:
+        print("init.c: SUSFS support could not be added", file=sys.stderr)
+        return False
+
+
+def modify_kbuild():
+    """在 Kbuild 中移除旧 hook 编译单元"""
+    kbuild = KSU_KERNEL / "Kbuild"
+    if not kbuild.exists():
+        print(f"WARNING: {kbuild} not found, skipping Kbuild cleanup", file=sys.stderr)
+        return True
+    s = kbuild.read_text(encoding="utf-8")
+    changed = False
+    # 与 upstream 10_enable_susfs_for_ksu.patch 保持一致：移除所有
+    # 与 SUSFS 冲突的 hook 编译单元，包括顶层和 ifeq 块内的 arch-specific 行
+    for obj in (
+        "kernelsu-objs += hook/lsm_hook.o",
+        "kernelsu-objs += hook/syscall_event_bridge.o",
+        "kernelsu-objs += hook/syscall_hook_manager.o",
+        "kernelsu-objs += hook/tp_marker.o",
+        "kernelsu-objs += hook/arm64/patch_memory.o",
+        "kernelsu-objs += hook/arm64/syscall_hook.o",
+        "kernelsu-objs += hook/x86_64/patch_memory.o",
+        "kernelsu-objs += hook/x86_64/syscall_hook.o",
+        "kernelsu-objs += hook/riscv64/patch_memory.o",
+        "kernelsu-objs += hook/riscv64/syscall_hook.o",
+    ):
+        count = s.count(obj)
+        if count > 0:
+            s = s.replace(obj + "\n", "", count)
+            changed = True
+    if changed:
+        kbuild.write_text(s, encoding="utf-8")
+        print("Kbuild: old hook objects removed")
+    else:
+        print("Kbuild: no old hook objects found")
+    return True
+
+
+def main():
+    kconfig_ok = modify_kconfig()
+    init_ok = modify_init_c()
+    kbuild_ok = modify_kbuild()
+
+    # init.c 是关键：没有 susfs_init() 就没有 SUSFS
+    if not init_ok:
+        print("ERROR: 无法在 KernelSU init.c 中集成 SUSFS，构建将中断", file=sys.stderr)
+        sys.exit(1)
+    sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/susfs_fixes/apply_susfs_compat.py b/scripts/susfs_fixes/apply_susfs_compat.py
new file mode 100644
index 0000000..033c3ed
--- /dev/null
+++ b/scripts/susfs_fixes/apply_susfs_compat.py
@@ -0,0 +1,109 @@
+#!/usr/bin/env python3
+"""Apply the upstream SUSFS patch across pre-refactor and current GKI 6.12."""
+
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+
+def adapt_patch(patch, exec_source, mmu_source):
+    sections = re.split(r"(?=^diff --git )", patch, flags=re.M)
+    old_rollup = (
+        "\tvma_start = vma->vm_start;\n\tdo {\n"
+        "\t\tsmap_gather_stats(vma, &mss, 0);"
+    ) in mmu_source
+
+    for index, section in enumerate(sections):
+        if section.startswith("diff --git a/fs/exec.c "):
+            if "#include <linux/dma-buf.h>" not in exec_source:
+                hunks = re.split(r"(?=^@@ )", section, flags=re.M)
+                if (
+                    len(hunks) < 2
+                    or hunks[1].count(" #include <linux/dma-buf.h>\n") != 1
+                ):
+                    raise ValueError("unexpected fs/exec.c SUSFS include hunk")
+                hunks[1] = hunks[1].replace(" #include <linux/dma-buf.h>\n", "", 1)
+                match = re.match(r"@@ -(\d+),(\d+) \+(\d+),(\d+) @@", hunks[1])
+                if not match:
+                    raise ValueError("unexpected fs/exec.c hunk header")
+                old_line, old_count, new_line, new_count = map(int, match.groups())
+                hunks[1] = re.sub(
+                    r"^@@ [^\n]+@@",
+                    f"@@ -{old_line},{old_count - 1} +{new_line},{new_count - 1} @@",
+                    hunks[1],
+                    count=1,
+                )
+                sections[index] = "".join(hunks)
+
+        elif section.startswith("diff --git a/fs/proc/task_mmu.c "):
+            if "if (!vma_pages(vma))" in mmu_source:
+                if section.count(" \tif (!vma_data_pages(vma))\n") != 1:
+                    raise ValueError("unexpected show_smap SUSFS hunk")
+                section = section.replace(
+                    " \tif (!vma_data_pages(vma))\n", " \tif (!vma_pages(vma))\n", 1
+                )
+
+            if old_rollup:
+                hunks = re.split(r"(?=^@@ )", section, flags=re.M)
+                discarded = [
+                    h
+                    for h in hunks[1:]
+                    if "show_smaps_rollup" in h.split("\n", 1)[0]
+                    and ("goto bypass_orig_flow;\n" in h or "\n+bypass_orig_flow:\n" in h)
+                ]
+                if len(discarded) != 2:
+                    raise ValueError("unexpected show_smaps_rollup SUSFS hunks")
+                section = "".join(h for h in hunks if h not in discarded)
+            sections[index] = section
+
+    return "".join(sections), old_rollup
+
+
+def guard_old_rollup(mmu_source):
+    start = mmu_source.index("static int show_smaps_rollup(")
+    end = mmu_source.index("\nstatic const struct seq_operations proc_pid_smaps_op", start)
+    rollup = mmu_source[start:end]
+    call = re.compile(
+        r"(?m)^(\t+)smap_gather_stats\(vma, &mss, (0|last_vma_end)\);$"
+    )
+    if len(call.findall(rollup)) != 3:
+        raise ValueError("unexpected pre-refactor smaps_rollup gather calls")
+
+    def guarded(match):
+        indent, offset = match.groups()
+        return (
+            "#ifdef CONFIG_KSU_SUSFS_SUS_MAP\n"
+            f"{indent}if (!vma->vm_file || "
+            "!(SUSFS_IS_INODE_SUS_MAP(file_inode(vma->vm_file))))\n"
+            "#endif\n"
+            f"{indent}\tsmap_gather_stats(vma, &mss, {offset});"
+        )
+
+    rollup = call.sub(guarded, rollup)
+    return mmu_source[:start] + rollup + mmu_source[end:]
+
+
+def main():
+    if len(sys.argv) != 3:
+        sys.exit("usage: apply_susfs_compat.py <kernel/common> <upstream.patch>")
+
+    tree, patch_file = Path(sys.argv[1]), Path(sys.argv[2])
+    exec_source = (tree / "fs/exec.c").read_text()
+    mmu_file = tree / "fs/proc/task_mmu.c"
+    adapted, old_rollup = adapt_patch(
+        patch_file.read_text(), exec_source, mmu_file.read_text()
+    )
+    subprocess.run(
+        ["patch", "--batch", "--forward", "-p1"],
+        cwd=tree,
+        input=adapted,
+        text=True,
+        check=True,
+    )
+    if old_rollup:
+        mmu_file.write_text(guard_old_rollup(mmu_file.read_text()))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/susfs_fixes/normalize_trace_ctx.py b/scripts/susfs_fixes/normalize_trace_ctx.py
new file mode 100644
index 0000000..ac42014
--- /dev/null
+++ b/scripts/susfs_fixes/normalize_trace_ctx.py
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+# 归一化 SUSFS 主补丁中「插入 susfs_def.h」hunk 的 trace/hooks 上下文
+#
+# 背景：
+#   SUSFS 上游 2026-10-18 把 gki-android13-5.15 主补丁 rebase 到 5.15.211，
+#   fs/proc/task_mmu.c 与 fs/namespace.c 的首个 hunk 变为以
+#   `#include <trace/hooks/mm.h>` / `#include <trace/hooks/blk.h>` 作为上下文。
+#   - 5.15.74~194 的 GKI 源码没有这两行，hunk 整段被拒 ->
+#     susfs_def.h 未引入 -> SUSFS_IS_INODE_* 隐式声明 -> clang -Werror 中断编译；
+#   - 5.15.220(LTS) 原生含这两行，旧脚本却为匹配 rebase 前的补丁把它们删掉，
+#     同样导致整段被拒。
+#
+# 策略：
+#   只处理「补丁体中出现 susfs_def.h」的 hunk；若该 hunk 的 trace/hooks 上下文行
+#   在目标文件头部不存在，就把这行从补丁副本中剔除并重算 hunk 行数。源码本身
+#   不做任何增删。目标文件已有该行时保持补丁原样。
+import re
+import sys
+
+HUNK_HDR = re.compile(r'^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@')
+TRACE_PREFIX = '#include <trace/hooks/'
+HEAD_LIMIT = 200
+
+
+def read_head(path):
+    """返回目标文件前 HEAD_LIMIT 行的去空白内容，文件不存在时返回 None。"""
+    try:
+        with open(path, encoding='utf-8', errors='surrogateescape') as f:
+            head = []
+            for _ in range(HEAD_LIMIT):
+                line = f.readline()
+                if not line:
+                    break
+                head.append(line.strip())
+            return head
+    except OSError:
+        return None
+
+
+def normalize(patch_path):
+    with open(patch_path, encoding='utf-8', errors='surrogateescape') as f:
+        lines = f.read().splitlines()
+
+    out = []
+    touched = set()
+    dropped = 0
+    cur_file = None
+    i = 0
+    while i < len(lines):
+        line = lines[i]
+        if line.startswith('+++ b/'):
+            cur_file = line[6:].split('\t')[0].strip()
+            out.append(line)
+            i += 1
+            continue
+
+        m = HUNK_HDR.match(line)
+        if not m:
+            out.append(line)
+            i += 1
+            continue
+
+        j = i + 1
+        body = []
+        while j < len(lines) and not lines[j].startswith(('@@', 'diff --git')):
+            body.append(lines[j])
+            j += 1
+
+        if cur_file and any('susfs_def.h' in l for l in body):
+            head = read_head(cur_file)
+            if head is not None:
+                kept = []
+                for l in body:
+                    ctx = l[1:].strip()
+                    if l[:1] == ' ' and ctx.startswith(TRACE_PREFIX) and ctx not in head:
+                        dropped += 1
+                        continue
+                    kept.append(l)
+                if len(kept) != len(body):
+                    old_count = sum(1 for l in kept if l[:1] in (' ', '-'))
+                    new_count = sum(1 for l in kept if l[:1] in (' ', '+'))
+                    line = '@@ -%s,%d +%s,%d @@' % (m.group(1), old_count, m.group(3), new_count)
+                    body = kept
+                    touched.add(cur_file)
+
+        out.append(line)
+        out.extend(body)
+        i = j
+
+    if dropped:
+        with open(patch_path, 'w', encoding='utf-8', errors='surrogateescape', newline='\n') as f:
+            f.write('\n'.join(out) + '\n')
+        print('SUSFS 补丁上下文已归一化：%s 移除 %d 行缺失的 trace/hooks 上下文'
+              % (', '.join(sorted(touched)), dropped))
+    else:
+        print('SUSFS 头文件上下文无需归一化')
+
+
+if __name__ == '__main__':
+    if len(sys.argv) != 2:
+        print('用法: normalize_trace_ctx.py <patch>', file=sys.stderr)
+        sys.exit(2)
+    normalize(sys.argv[1])
