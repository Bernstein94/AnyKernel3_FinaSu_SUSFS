+        required: false
+        type: boolean
+        default: false
+      use_nomount:
+        required: false
+        type: boolean
+        default: false
+      cve_2026_43499_patch:
+        required: false
+        type: boolean
+        default: false
+      ksu_mode:
+        required: false
+        type: string
+        default: "关闭"
+      droidspaces:
+        required: false
+        type: string
+        default: "off"
+      artifact_upload_mode:
+        required: false
+        type: string
+        default: "上传全部"
+      droidspaces_ntsync:
+        required: false
+        type: boolean
+        default: false
+      skip_incompatible:
+        required: false
