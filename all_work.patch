+        type: choice
+        options:
+          - "关闭"
+          - "禁用SUSFS"
+          - "禁用KSU"
+        default: "关闭"
+      droidspaces_ntsync:
+        description: "启用 Droidspaces 容器 NTSync 支持（需启用 Droidspaces）"
+        required: false
+        type: boolean
+        default: false
+      use_zram:
+        description: "启用 ZRAM 压缩算法"
+        required: true
+        type: boolean
+        default: false
+      use_bbg:
+        description: "启用 BBG 基带保护"
+        required: true
+        type: boolean
+        default: false
+      use_net_enhance:
+        description: "启用 网络增强 (BBRv3 + IPSet + Qdisc + CIFS)"
+        required: true
+        type: boolean
+        default: false
+      use_rekernel:
