@@ -0,0 +1,257 @@
+name: 内核构建 - Android 17 (6.18)
+
+permissions:
+  contents: write
+  actions: write
+
+on:
+  workflow_dispatch:
+    inputs:
+      kernelsu_variant:
+        description: "KernelSU 变体"
+        required: true
+        type: choice
+        options:
+          - SukiSU-Nova
+          - BakaSU
+          - FinaSU
+          - KernelSU
+        default: FinaSU
+      build_channel:
+        description: "构建管理器通道"
+        required: false
+        type: choice
+        options:
+          - "正式 (Release)"
+          - "最新 (HEAD)"
+        default: "正式 (Release)"
+      version:
+        description: "自定义内核版本名"
+        required: false
+        type: string
+      build_time:
+        description: "自定义构建时间 (留空=自动获取当前北京时间) (示例 Tue Dec  1 08:10:00 UTC 2026)"
+        required: false
+        type: string
+        default: ""
+      use_kpm:
+        description: "KPM 功能（仅SukiSU-Nova支持，开启未修补）"
+        required: true
+        type: boolean
+        default: false
+      droidspaces:
+        description: "Droidspaces 容器支持"
+        required: false
+        type: choice
+        options:
+          - "off"
+          - "678"
+          - "123"
+          - "345"
+        default: "off"
+      artifact_upload_mode:
+        description: "构建产物上传模式"
+        required: true
+        type: choice
+        options:
+          - "仅上传 AnyKernel3.zip"
+          - "上传全部"
+        default: "仅上传 AnyKernel3.zip"
+      ksu_mode:
+        description: "KernelSU / SUSFS 模式（android17-6.18 的 SUSFS 固定禁用）"
+        required: true
+        type: choice
+        options:
+          - "关闭"
+          - "禁用SUSFS"
+          - "禁用KSU"
+        default: "关闭"
+      droidspaces_ntsync:
+        description: "启用 Droidspaces 容器 NTSync 支持（需启用 Droidspaces）"
+        required: false
+        type: boolean
+        default: false
+      use_bbg:
+        description: "启用 BBG 基带保护"
+        required: true
+        type: boolean
+        default: false
+      use_net_enhance:
+        description: "启用 网络增强 (BBRv3 + IPSet + Qdisc + CIFS)"
+        required: true
+        type: boolean
+        default: false
+      use_rekernel:
+        description: "启用 Re-Kernel 驱动"
+        required: false
+        type: boolean
+        default: false
+      use_nomount:
+        description: "启用 NoMount 挂载元模块（需自行刷入配套模块）"
+        required: false
+        type: boolean
+        default: false
+      cve_2026_43499_patch:
+        description: "应用 CVE-2026-43499 rtmutex 修复链"
+        required: false
+        type: boolean
+        default: false
+      skip_incompatible:
+        description: "功能不兼容或无法使用时自动跳过该功能（不中断构建）"
+        required: false
+        type: boolean
+        default: true
+  workflow_call:
+    inputs:
+      kernelsu_variant:
+        required: true
+        type: string
+      build_channel:
+        description: "构建通道（从 main.yml 传入；直接触发时取本工作流拉取的管理器来源）"
+        required: false
+        type: string
+        default: "正式 (Release)"
+      version:
+        required: false
+        type: string
+      build_time:
+        required: false
+        type: string
+        default: ""
+      use_bbg:
+        required: true
+        type: boolean
+      use_net_enhance:
+        required: true
+        type: boolean
+        default: false
+      use_kpm:
+        required: false
+        type: boolean
+        default: false
+      use_rekernel:
+        required: false
+        type: boolean
+        default: false
+      use_nomount:
+        required: false
+        type: boolean
+        default: false
+      cve_2026_43499_patch:
+        required: false
+        type: boolean
+        default: false
+      ksu_mode:
+        required: false
+        type: string
+        default: "关闭"
+      droidspaces:
+        required: false
+        type: string
+        default: "off"
+      artifact_upload_mode:
+        required: false
+        type: string
+        default: "上传全部"
+      droidspaces_ntsync:
+        required: false
+        type: boolean
+        default: false
+      skip_incompatible:
+        required: false
+        type: boolean
+        default: true
+      called_from_main:
+        description: "是否从 main.yml 调用（内部使用）"
+        required: false
+        type: boolean
+        default: false
+      ksu_commit:
+        description: "官方最新上传构建的 KernelSU 提交（从 main.yml 传入；直接触发时自动取本工作流拉取的管理器构建）"
+        required: false
+        type: string
+        default: ""
+
+      ksu_cert_size:
+        description: "FinaSU 管理器签名证书 DER 尺寸（从 main.yml 传入；直接触发时自动取本工作流拉取的管理器证书）"
+        required: false
+        type: string
+        default: ""
+
+      ksu_cert_hash:
+        description: "FinaSU 管理器签名证书 SHA256（从 main.yml 传入；直接触发时自动取本工作流拉取的管理器证书）"
+        required: false
+        type: string
+        default: ""
