@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+import pathlib
+import re
+import sys
+
+API = "https://git.zako.shirkneko.top:20004/api/v1/repos/$(REPO_OWNER)/$(REPO_NAME)"
+replacements = {
+    "REPO_OWNER": "REPO_OWNER  := shirkneko",
+    "REPO_NAME": "REPO_NAME   := SukiSU",
+    "VERSION_OFFSET": "VERSION_OFFSET  := 996",
+    "GITHUB_API_BASE": f"RELEASE_API_BASE := {API}",
+    "GITHUB_COMMITS": (
+        'RELEASE_COMMITS  := $(shell $(CURL_BIN) -s -D - -o /dev/null '
+        '"$(RELEASE_API_BASE)/commits?sha=$(REPO_BRANCH)&limit=1" 2>/dev/null '
+        "| tr -d '\\r' | sed -n 's/^[Xx]-[Tt]otal-[Cc]ount:[[:space:]]*\\([0-9]*\\).*/\\1/p')"
+    ),
+    "LOCAL_COUNT": "LOCAL_COUNT     := $(if $(RELEASE_COMMITS),$(RELEASE_COMMITS),$(git_commit_count))",
+    "KSU_VERSION": (
+        "KSU_VERSION     := $(if $(LOCAL_COUNT),"
+        "$(shell expr $(VERSION_BASE) + $(LOCAL_COUNT) + $(VERSION_OFFSET)),$(VERSION_BASE))"
+    ),
+    "KSU_GITHUB_VER": (
+        'KSU_RELEASE_VER  := $(shell $(CURL_BIN) -s "$(RELEASE_API_BASE)/releases/latest" '
+        "2>/dev/null | grep -o '\"tag_name\":\"[^\"]*\"' | head -1 | cut -d'\"' -f4 | sed 's/^v//')"
+    ),
+    "VERSION_TAG": "VERSION_TAG     := $(or $(KSU_RELEASE_VER),$(git_latest_tag),3.0.0)",
+}
+
+path = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else "KernelSU/kernel/Makefile")
+lines = path.read_text(encoding="utf-8").splitlines(keepends=True)
+for key, replacement in replacements.items():
+    pattern = re.compile(rf"^{key}\s*:=.*$")
+    matched = False
+    for index, line in enumerate(lines):
+        if pattern.match(line.rstrip("\r\n")):
+            ending = "\r\n" if line.endswith("\r\n") else "\n"
+            lines[index] = replacement + ending
+            matched = True
+            break
+    if not matched:
+        sys.exit(f"missing {key} in {path}")
+
+path.write_text("".join(lines), encoding="utf-8", newline="")
diff --git a/scripts/ksu_uapi_sync/symbol_resolver.c b/scripts/ksu_uapi_sync/symbol_resolver.c
new file mode 100644
index 0000000..fe65337
--- /dev/null
+++ b/scripts/ksu_uapi_sync/symbol_resolver.c
@@ -0,0 +1,391 @@
+#include <linux/bsearch.h>
+#include <linux/kallsyms.h>
+#include <linux/module.h>
+#include <linux/mm.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/sort.h>
+#include <linux/string.h>
+#include <linux/version.h>
+
+#include "infra/symbol_resolver.h"
+
+// https://github.com/torvalds/linux/commit/89245600941e4e0f87d77f60ee269b5e61ef4e49
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+#define USE_KCFI 1
+#else
+#define USE_KCFI 0
+#endif
+
+#if !USE_KCFI
+static const char cfi_suffix[] = ".cfi_jt";
+static const size_t cfi_suffix_len = sizeof(cfi_suffix) - 1;
+#endif
+
+// It's not guaranteed to have this symbol exist in 5.x kernel
+// https://github.com/torvalds/linux/commit/d721def7392a7348ffb9f3583b264239cbd3702c
+// https://github.com/gregkh/linux/commit/2aa861ec72908b4bdc20d74725dc1c8c71a8d214
+// https://github.com/gregkh/linux/commit/318a206633c248d876ea72f7133d2a2e50ad7e35
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 19, 0)
+#define ALWAYS_HAVE_ON_EACH_SYMBOL 1
+#else
+#define ALWAYS_HAVE_ON_EACH_SYMBOL 0
+#endif
+
+#if !ALWAYS_HAVE_ON_EACH_SYMBOL
+static int (*kallsyms_on_each_symbol_fn)(int (*fn)(void *, const char *, struct module *, unsigned long),
+                                         void *data) = NULL;
+#endif
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+#define HAVE_ON_EACH_MATCH_SYMBOL 1
+#else
+#define HAVE_ON_EACH_MATCH_SYMBOL 0
+#endif
+
+// https://github.com/torvalds/linux/commit/4dc533e0f2c04174e1ae4aa98e7cffc1c04b9998
+#if HAVE_ON_EACH_MATCH_SYMBOL
+static int (*kallsyms_on_each_match_symbol_fn)(int (*fn)(void *, unsigned long), const char *name, void *data) = NULL;
+static int find_kernel_symbol_exact_cb(void *data, unsigned long addr)
+{
+    *(unsigned long *)data = addr;
+    return 0;
+}
+#endif
+
+struct ksu_lookup_symbol_ctx {
+    const char *symbol_name;
+    size_t symbol_len;
+    void *match;
+};
+
+unsigned long __nocfi find_kernel_symbol_exact(const char *symbol_name)
+{
+    unsigned long addr = 0;
+#if HAVE_ON_EACH_MATCH_SYMBOL
+    if (likely(kallsyms_on_each_match_symbol_fn)) {
+        kallsyms_on_each_match_symbol_fn(find_kernel_symbol_exact_cb, symbol_name, &addr);
+        return addr;
+    }
+#endif
+    char *module_name = NULL;
+    char buf[KSYM_SYMBOL_LEN];
+
+    addr = kallsyms_lookup_name(symbol_name);
+    // check if it is kernel symbol
+    kallsyms_lookup(addr, NULL, NULL, &module_name, buf);
+    if (unlikely(module_name)) {
+        pr_warn("ignore symbol %s of module %s\n", symbol_name, module_name);
+        return 0;
+    }
+    return addr;
+}
+
+static inline bool ksu_symbol_has_suffix(const char *name, size_t name_len, const char *suffix, size_t suffix_len)
+{
+    return name_len >= suffix_len && strcmp(name + name_len - suffix_len, suffix) == 0;
+}
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
+static int lookup_symbol_variant_cb(void *data, const char *name, unsigned long addr)
+#else
+static int lookup_symbol_variant_cb(void *data, const char *name, struct module *mod, unsigned long addr)
+#endif
+{
+    struct ksu_lookup_symbol_ctx *ctx = data;
+    size_t name_len;
+
+    if (!name || !addr)
+        return 0;
+
+    name_len = strlen(name);
+
+    if (strcmp(name, ctx->symbol_name) != 0) {
+        if (name_len <= ctx->symbol_len || strncmp(name, ctx->symbol_name, ctx->symbol_len) != 0 ||
+            name[ctx->symbol_len] != '.')
+            return 0;
+    }
+
+#if !USE_KCFI
+    if (ksu_symbol_has_suffix(name, name_len, cfi_suffix, cfi_suffix_len)) {
+        ctx->match = (void *)addr;
+        pr_info("use .cfi_jt variant: %s\n", name);
+        return 1;
+    }
+#endif
+
+    if (!ctx->match) {
+        ctx->match = (void *)addr;
+        pr_info("found variant: %s\n", name);
+#if USE_KCFI
+        return 1;
+#endif
+    }
+
+    return 0;
+}
+
+static __nocfi void *resolve_symbol_variant(const char *symbol_name, size_t symbol_len)
+{
+    struct ksu_lookup_symbol_ctx ctx = {
+        .symbol_name = symbol_name,
+        .symbol_len = symbol_len,
+    };
+
+#if !ALWAYS_HAVE_ON_EACH_SYMBOL
+    if (kallsyms_on_each_symbol_fn) {
+        kallsyms_on_each_symbol_fn(lookup_symbol_variant_cb, &ctx);
+    }
+    // TODO: iterate kallsyms by sprint_symbol
+#else
+    kallsyms_on_each_symbol(lookup_symbol_variant_cb, &ctx);
+#endif
+    return ctx.match;
+}
+
+void *ksu_resolve_symbol_for_functable_hook(const char *symbol_name)
+{
+    void *addr;
+    size_t symbol_len;
+
+    if (!symbol_name || !symbol_name[0])
+        return NULL;
+
+    symbol_len = strlen(symbol_name);
+
+    // Prefer find_kernel_symbol_exact since it uses binary search in higher kernel version
+
+#if !USE_KCFI
+    // Try .cfi_jt suffix first
+    char cfi_name[KSYM_NAME_LEN];
+    snprintf(cfi_name, sizeof(cfi_name), "%s.cfi_jt", symbol_name);
+    addr = (void *)find_kernel_symbol_exact(cfi_name);
+    if (addr)
+        return addr;
+
+    addr = resolve_symbol_variant(symbol_name, symbol_len);
+    if (addr)
+        return addr;
+
+    return (void *)find_kernel_symbol_exact(symbol_name);
+#else
+    addr = (void *)find_kernel_symbol_exact(symbol_name);
+    if (addr)
+        return addr;
+
+    return resolve_symbol_variant(symbol_name, symbol_len);
+#endif
+}
+
+struct ksu_batch_entry {
+    const char *name;
+    unsigned long addr;
+    u32 idx;
+};
+
+struct ksu_batch_ctx {
+    struct ksu_batch_entry *entries; // sorted by name
+    u32 count;
+    u32 remaining;
+    char key[KSYM_NAME_LEN];
+};
+
+static int ksu_batch_entry_cmp(const void *a, const void *b)
+{
+    return strcmp(((const struct ksu_batch_entry *)a)->name, ((const struct ksu_batch_entry *)b)->name);
+}
+
+static int ksu_batch_key_cmp(const void *key, const void *elt)
+{
+    return strcmp(key, ((const struct ksu_batch_entry *)elt)->name);
+}
+
+/*
+ * Match one kallsyms entry against the requested names. Same rule as
+ * ksuinit's /proc/kallsyms walk: the kernel name is cut at the first '$',
+ * else at ".llvm.", and the first match in kallsyms order wins.
+ * Returns 1 to stop the walk once every name is resolved.
+ */
+static int ksu_batch_match(struct ksu_batch_ctx *ctx, const char *name, unsigned long addr)
+{
+    struct ksu_batch_entry *e, *end = ctx->entries + ctx->count;
+    const char *cut, *key = name;
+    size_t len;
+
+    if (fatal_signal_pending(current))
+        return -EINTR;
+    if (!name || !addr)
+        return 0;
+
+    cut = strchr(name, '$');
+    if (!cut)
+        cut = strstr(name, ".llvm.");
+    if (cut) {
+        len = cut - name;
+        if (!len || len >= sizeof(ctx->key))
+            return 0;
+        memcpy(ctx->key, name, len);
+        ctx->key[len] = '\0';
+        key = ctx->key;
+    }
+
+    e = bsearch(key, ctx->entries, ctx->count, sizeof(*e), ksu_batch_key_cmp);
+    if (!e)
+        return 0;
+    // The same name may be requested more than once.
+    while (e > ctx->entries && !strcmp(e[-1].name, key))
+        e--;
+    for (; e < end && !strcmp(e->name, key); e++) {
+        if (!e->addr) {
+            e->addr = addr;
+            ctx->remaining--;
+        }
+    }
+    return ctx->remaining ? 0 : 1;
+}
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
+static int ksu_batch_cb(void *data, const char *name, unsigned long addr)
+{
+    return ksu_batch_match(data, name, addr);
+}
+#else
+static int ksu_batch_cb(void *data, const char *name, struct module *mod, unsigned long addr)
+{
+    // vmlinux symbols come first; like ksuinit, stop at module symbols.
+    if (mod)
+        return 1;
+    return ksu_batch_match(data, name, addr);
+}
+#endif
+
+#if HAVE_ON_EACH_MATCH_SYMBOL
+// Equal names are ordered by address, i.e. kallsyms order: keep the first.
+static int ksu_first_match_cb(void *data, unsigned long addr)
+{
+    *(unsigned long *)data = addr;
+    return 1;
+}
+
+// Indexed per-name lookups, which also strip ".llvm." where the kernel does.
+static __nocfi int ksu_batch_lookup_indexed(struct ksu_batch_ctx *ctx)
+{
+    u32 i;
+
+    if (!kallsyms_on_each_match_symbol_fn)
+        return 0;
+    for (i = 0; i < ctx->count && ctx->remaining; i++) {
+        struct ksu_batch_entry *e = &ctx->entries[i];
+
+        if (e->addr)
+            continue;
+        kallsyms_on_each_match_symbol_fn(ksu_first_match_cb, e->name, &e->addr);
+        if (!e->addr)
+            continue;
+        ctx->remaining--;
+        // Duplicate requests share the result.
+        while (i + 1 < ctx->count && !strcmp(ctx->entries[i + 1].name, e->name)) {
+            ctx->entries[++i].addr = e->addr;
+            ctx->remaining--;
+        }
+        if (fatal_signal_pending(current))
+            return -EINTR;
+    }
+    return 0;
+}
+#endif
+
+/*
+ * Resolve @count kernel image symbols. NULL entries in @names are skipped.
+ * @addrs[i] is 0 for names that do not resolve. Returns the number of
+ * resolved names, or -errno.
+ *
+ * 6.1+ kernels index kallsyms by name, so names are looked up one by one
+ * there; whatever that misses ('$' suffixes, ".llvm." on 6.12+, unknown
+ * names) and every name on older kernels, where a lookup by name is a linear
+ * scan, is resolved by a single kallsyms walk.
+ */
+int __nocfi ksu_lookup_kernel_symbols(const char *const *names, unsigned long *addrs, u32 count)
+{
+    struct ksu_batch_ctx *ctx;
+    int ret = 0;
+    u32 i, n = 0;
+
+    ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
+    if (!ctx)
+        return -ENOMEM;
+    ctx->entries = kvmalloc_array(count, sizeof(*ctx->entries), GFP_KERNEL);
+    if (!ctx->entries) {
+        kfree(ctx);
+        return -ENOMEM;
+    }
+
+    for (i = 0; i < count; i++) {
+        addrs[i] = 0;
+        if (!names[i])
+            continue;
+        ctx->entries[n].name = names[i];
+        ctx->entries[n].addr = 0;
+        ctx->entries[n].idx = i;
+        n++;
+    }
+    ctx->count = n;
+    ctx->remaining = n;
+    sort(ctx->entries, n, sizeof(*ctx->entries), ksu_batch_entry_cmp, NULL);
+
+#if HAVE_ON_EACH_MATCH_SYMBOL
+    if (n)
+        ret = ksu_batch_lookup_indexed(ctx);
+#endif
+
+    if (ret >= 0 && ctx->remaining) {
+#if !ALWAYS_HAVE_ON_EACH_SYMBOL
+        if (kallsyms_on_each_symbol_fn) {
+            ret = kallsyms_on_each_symbol_fn(ksu_batch_cb, ctx);
+        } else {
+            // No kallsyms walker: fall back to exact per-name lookups.
+            for (i = 0; i < n; i++) {
+                if (ctx->entries[i].addr)
+                    continue;
+                ctx->entries[i].addr = find_kernel_symbol_exact(ctx->entries[i].name);
+                if (fatal_signal_pending(current)) {
+                    ret = -EINTR;
+                    break;
+                }
+                cond_resched();
+            }
+        }
+#else
+        ret = kallsyms_on_each_symbol(ksu_batch_cb, ctx);
+#endif
+    }
+
+    if (ret >= 0) {
+        ret = 0;
+        for (i = 0; i < n; i++) {
+            addrs[ctx->entries[i].idx] = ctx->entries[i].addr;
+            if (ctx->entries[i].addr)
+                ret++;
+        }
+    }
+
+    kvfree(ctx->entries);
+    kfree(ctx);
+    return ret;
+}
+
+void __init ksu_init_symbol_resolver()
+{
+#if !ALWAYS_HAVE_ON_EACH_SYMBOL
+    kallsyms_on_each_symbol_fn = find_kernel_symbol_exact("kallsyms_on_each_symbol");
+    if (!kallsyms_on_each_symbol_fn) {
+        pr_warn("kallsyms_on_each_symbol not found!\n");
+    }
+#endif
+#if HAVE_ON_EACH_MATCH_SYMBOL
+    kallsyms_on_each_match_symbol_fn = find_kernel_symbol_exact("kallsyms_on_each_match_symbol");
+    if (!kallsyms_on_each_match_symbol_fn) {
+        pr_warn("kallsyms_on_each_match_symbol not found!\n");
+    }
+#endif
+}
diff --git a/scripts/ksu_uapi_sync/symbol_resolver.h b/scripts/ksu_uapi_sync/symbol_resolver.h
new file mode 100644
index 0000000..960a81a
--- /dev/null
+++ b/scripts/ksu_uapi_sync/symbol_resolver.h
@@ -0,0 +1,11 @@
+#ifndef __KSU_SYMBOL_RESOLVER_H
+#define __KSU_SYMBOL_RESOLVER_H
+
+#include <linux/types.h>
+
+void *ksu_resolve_symbol_for_functable_hook(const char *symbol_name);
+unsigned long find_kernel_symbol_exact(const char *symbol_name);
+int ksu_lookup_kernel_symbols(const char *const *names, unsigned long *addrs, u32 count);
+void ksu_init_symbol_resolver();
+
+#endif
diff --git a/scripts/ksu_uapi_sync/sync_uapi.sh b/scripts/ksu_uapi_sync/sync_uapi.sh
new file mode 100644
index 0000000..2295452
--- /dev/null
+++ b/scripts/ksu_uapi_sync/sync_uapi.sh
@@ -0,0 +1,365 @@
+#!/usr/bin/env bash
+# SukiSU-Nova builtin 分支内核 UAPI 动态同步（对齐官方 main 分支管理器）
+#
+# 背景：
+#   builtin 分支（内建+SUSFS 产品线）与官方 main 分支相互独立，
+#   官方管理器 APK 始终按 main 分支构建。main 的 uapi/supercall.h
+#   抬升 KERNEL_SU_UAPI_VERSION 时（如 3b60791 把 UAPI 升到 6 并新增
+#   KSU_IOCTL_LOOKUP_SYMBOLS / KSU_GET_INFO_FLAG_PREINIT），builtin 检出
+#   的内核 UAPI 落后于管理器，管理器 requiresNewKernel = true，
+#   首页报"需要更新内核"（Natives.kt: managerUAPIVersion > kernelUAPIVersion）。
+#
+# 本脚本动态移植：读取官方 main 的 uapi/supercall.h，将其相对 builtin
+# 检出缺失的「UAPI 常量声明 + KSU_GET_INFO_FLAG_* 位 + 新增 ioctl 常量 +
+# struct ksu_lookup_symbols_cmd」按官方原文追加到 builtin 头文件，
+# UAPI 号抬到与 main 一致。内核侧配套能力（LOOKUP_SYMBOLS 处理器、
+# symbol_resolver）由 build.yml 在本脚本之后以独立内容检测步骤注入。
+#
+# 移植均为内容检测：已包含则跳过，重复执行幂等；上游 builtin 自行同步
+# UAPI 后同样自动跳过。
+#
+# 用法: sync_uapi.sh [KernelSU 目录]（调用方工作目录需为 $KERNEL_ROOT，
+#       需可访问官方仓库 raw.githubusercontent.com）
+
+set -eo pipefail
+
+KSU_DIR="${1:-KernelSU}"
+
+fail() {
+  if [ "$SKIP_INCOMPATIBLE" = "true" ]; then
+    echo "::warning title=SukiSU-Nova UAPI 同步已跳过::$1"
+    if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
+      echo "" >> "$GITHUB_STEP_SUMMARY"
+      echo "> ⏭️ **SukiSU-Nova UAPI 同步** 已自动跳过：$1（构建未中断）" >> "$GITHUB_STEP_SUMMARY"
+    fi
+    exit 0
+  fi
+  echo "::error::$1"
+  exit 1
+}
+
+[ -d "$KSU_DIR" ] || fail "未找到 KernelSU 目录: $KSU_DIR"
+
+COMPAT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+# builtin 分支: kernel/include/uapi/supercall.h；main 分支: uapi/supercall.h
+UAPI_FILE=""
+for f in "$KSU_DIR/kernel/include/uapi/supercall.h" "$KSU_DIR/uapi/supercall.h"; do
+  if [ -f "$f" ]; then
+    UAPI_FILE="$f"
+    break
+  fi
+done
+[ -n "$UAPI_FILE" ] || fail "未找到 supercall.h，SukiSU-Nova 源码布局可能已变化"
+
+read_uapi() {
+  grep -ohE 'KERNEL_SU_UAPI_VERSION[^0-9]*[0-9]+' "$1" | grep -oE '[0-9]+' | tail -n 1
+}
+
+# 取官方 main 的 supercall.h（web 布局，UAPI 定义以 static const 发布）
+MAIN_URL="https://git.zako.shirkneko.top:20004/shirkneko/SukiSU/raw/branch/main/uapi/supercall.h"
+MAIN_FILE=$(mktemp)
+MAIN_JSON=""
+for ATTEMPT in 1 2 3; do
+  if curl -sL --fail --max-time 60 -o "$MAIN_FILE" "$MAIN_URL" && [ -s "$MAIN_FILE" ]; then
+    break
+  fi
+  echo "拉取官方 main supercall.h 失败，重试 ($ATTEMPT/3)..."
+  sleep 5
+done
+[ -s "$MAIN_FILE" ] || fail "无法拉取官方 main uapi/supercall.h，UAPI 同步中止"
+
+MAIN_UAPI=$(read_uapi "$MAIN_FILE")
+CUR_UAPI=$(read_uapi "$UAPI_FILE")
+echo "官方 main UAPI 版本: ${MAIN_UAPI:-未知}, builtin 检出当前 UAPI 版本: ${CUR_UAPI:-未知}"
+[ -n "$MAIN_UAPI" ] || fail "官方 main supercall.h 中未解析到 KERNEL_SU_UAPI_VERSION"
+
+if [ "${CUR_UAPI:-0}" -ge "$MAIN_UAPI" ]; then
+  echo "builtin 检出 UAPI >= 官方 main（$CUR_UAPI >= $MAIN_UAPI），无需同步，跳过"
+  rm -f "$MAIN_FILE"
+  exit 0
+fi
+
+python3 - "$UAPI_FILE" "$MAIN_FILE" <<'PYEOF'
+import sys, re
+
+uapi_path, main_path = sys.argv[1], sys.argv[2]
+uapi = open(uapi_path, encoding="utf-8", errors="surrogateescape").read()
+main = open(main_path, encoding="utf-8", errors="surrogateescape").read()
+
+def read_num(text, name):
+    m = re.search(re.escape(name) + r"[^0-9]*(\d+)", text)
+    return int(m.group(1)) if m else None
+
+main_ver = read_num(main, "KERNEL_SU_UAPI_VERSION")
+cur_ver = read_num(uapi, "KERNEL_SU_UAPI_VERSION")
+if not main_ver:
+    print("::error::官方 main supercall.h 缺少 KERNEL_SU_UAPI_VERSION")
+    sys.exit(1)
+
+changed = []
+
+# 1) 按官方值移植 builtin 缺失的常量（含抬升后的 KERNEL_SU_UAPI_VERSION、
+#    EVENT_*、KSU_GET_INFO_FLAG_*、新 ioctl 常量、KSU_LOOKUP_SYMBOLS_MAX 等）。
+#    声明形式跟随 builtin 现有的 DECLARE 宏（非 BINDGEN 下展开为 enum，
+#    是编译期常量，dispatch.c 的 static 处理表才能引用；main 的 static const
+#    形式在 builtin 的 static 初始化器上下文会报
+#    "initializer element is not a compile-time constant"）。
+#    逐常量移植而非整文件替换：builtin 头还有独立演化内容
+#    （DECLARE 宏、__user 注记的 ksu_kpm_cmd 等），整替换会互相覆盖。
+def parse_decls(text):
+    decls = {}
+    for m in re.finditer(r"^static const (\w[\w\s\*]*?)\b(\w+)\s*=\s*([^;\n]+);", text, re.M):
+        decls.setdefault(m.group(2), (m.group(1), m.group(3)))
+    return decls
+
+main_decls = parse_decls(main)
+has_declare = "#define DECLARE" in uapi
+
+# 2) 移植 builtin 缺失的 struct 定义（如 ksu_lookup_symbols_cmd /
+#    ksu_set_spoof_version_cmd）。struct 必须先于引用它的 _IOW 常量声明，
+#    且插入点需在 include guard 内（supercall.h 会被 ksu.c / dynamic_manager.c
+#    多次 include，文件尾 #endif 之外的内容每次 include 都会重复定义）。
+struct_re = re.compile(r"^struct (\w+) \{(?:[^{}])*?\};", re.M | re.S)
+main_structs = []
+for m in struct_re.finditer(main):
+    main_structs.append((m.group(1), m.group(0)))
+
+missing_structs = [(n, t) for n, t in main_structs if not re.search(r"struct\s+" + re.escape(n) + r"\s*\{", uapi)]
+missing_decls = {n: v for n, v in main_decls.items() if not re.search(r"\b" + re.escape(n) + r"\b", uapi)}
+
+# 统一插入点：flag 区块之后（guard 内、DECLARE 宏之后、struct/常量使用之前）
+anchor = re.search(r"(DECLARE\(__u32, KSU_GET_INFO_FLAG_PR_BUILD[^\n]*\n|static const __u32 KSU_GET_INFO_FLAG_PR_BUILD[^\n]*\n)", uapi)
+if not anchor:
+    anchor = re.search(r"(DECLARE\(__u32, KERNEL_SU_UAPI_VERSION[^\n]*\n|static const __u32 KERNEL_SU_UAPI_VERSION[^\n]*\n)", uapi)
+if not anchor:
+    print("::error::builtin supercall.h 缺常量/struct 插入锚点（UAPI/FLAG 区块）")
+    sys.exit(1)
+pos = anchor.end()
+
+block = "\n// synced from SukiSU-Nova main uapi/supercall.h (dynamic UAPI sync)\n"
+# struct 先插（同名的 _IOW 常量在插入块里引用它们）
+for sname, text in missing_structs:
+    block += text + "\n"
+    changed.append("struct " + sname)
+for name, (ctype, value) in missing_decls.items():
+    if has_declare:
+        block += "DECLARE(%s, %s, %s);\n" % (ctype, name, value)
+    else:
+        block += "static const %s %s = %s;\n" % (ctype, name, value)
+    changed.append(name)
+if missing_decls:
+    block += "\n"
+
+uapi = uapi[:pos] + block + uapi[pos:]
+
+# 3) 抬升 UAPI 号到官方值
+if cur_ver is not None and cur_ver < main_ver:
+    uapi = re.sub(
+        r"((?:DECLARE\(__u32, KERNEL_SU_UAPI_VERSION|static const __u32 KERNEL_SU_UAPI_VERSION)[^\n]*?)\b%d\b" % cur_ver,
+        r"\g<1>%d" % main_ver,
+        uapi, count=1)
+    changed.append("KERNEL_SU_UAPI_VERSION %d -> %d" % (cur_ver, main_ver))
+
+if not changed:
+    print("supercall.h: 无需移植（UAPI 号与常量均已包含）")
+else:
+    open(uapi_path, "w", encoding="utf-8", errors="surrogateescape").write(uapi)
+    for c in changed:
+        print("supercall.h: 移植 %s" % c)
+PYEOF
+
+# ---------------- 内核侧配套能力注入（LOOKUP_SYMBOLS / symbol_resolver） ----------------
+# UAPI >= 6 时管理器会探测 KSU_IOCTL_LOOKUP_SYMBOLS（热装模块符号绑定用）。
+# 该能力依赖 main 分支的 infra/symbol_resolver，builtin 检出缺少它，按内容
+# 检测注入：分发 resolver 源码 + 补内核 include + 接线 do_lookup_symbols。
+if grep -q 'KSU_IOCTL_LOOKUP_SYMBOLS' "$UAPI_FILE" 2>/dev/null; then
+  RESOLVER_C="$KSU_DIR/kernel/infra/symbol_resolver.c"
+  RESOLVER_H="$KSU_DIR/kernel/infra/symbol_resolver.h"
+  if [ ! -f "$RESOLVER_C" ] || ! grep -q 'ksu_lookup_kernel_symbols' "$RESOLVER_C" 2>/dev/null; then
+    echo "注入 infra/symbol_resolver (main 分支 UAPI6 符号批量解析)..."
+    cp "$COMPAT_DIR/symbol_resolver.h" "$RESOLVER_H" || fail "symbol_resolver.h 分发失败"
+    cp "$COMPAT_DIR/symbol_resolver.c" "$RESOLVER_C" || fail "symbol_resolver.c 分发失败"
+    grep -q 'ksu_lookup_kernel_symbols' "$RESOLVER_C" || fail "symbol_resolver.c 分发后校验失败"
+  else
+    echo "infra/symbol_resolver 已存在，跳过分发"
+  fi
+
+  # builtin 以 ksu.c unity build 编译（kernel_includes.h 聚合内核头），
+  # resolver 依赖的 bsearch/sort/kallsyms 头不在其中，按需补齐。
+  KINC="$KSU_DIR/kernel/kernel_includes.h"
+  if [ -f "$KINC" ] && [ -f "$RESOLVER_C" ]; then
+    for HDR in bsearch sort kallsyms; do
+      if grep -q "ksu_lookup_kernel_symbols" "$RESOLVER_C" && ! grep -q "include <linux/$HDR.h>" "$KINC"; then
+        sed -i "s|^#include <linux/kernel.h>|#include <linux/kernel.h>\n#include <linux/$HDR.h>|" "$KINC" \
+          || fail "kernel_includes.h 补 <linux/$HDR.h> 失败"
+        grep -q "include <linux/$HDR.h>" "$KINC" || fail "kernel_includes.h <linux/$HDR.h> 校验失败"
+        echo "kernel_includes.h: 补 <linux/$HDR.h>"
+      fi
+    done
+  fi
+
+  # 接线 include + 处理器 + ioctl 表项（builtin dispatch.c 无 include，unity build）
+  DISPATCH="$KSU_DIR/kernel/supercall/dispatch.c"
+  if [ -f "$DISPATCH" ] && [ -f "$RESOLVER_C" ]; then
+    if ! grep -q 'do_lookup_symbols' "$DISPATCH"; then
+      echo "接线 supercall/dispatch.c: do_lookup_symbols 处理器..."
+      python3 - "$DISPATCH" "$UAPI_FILE" <<'PYEOF2'
+import sys, re
+
+path = sys.argv[1]
+s = open(path, encoding="utf-8", errors="surrogateescape").read()
+
+# 1) include resolver（unity build 下放 include 源码前声明）
+if '#include "infra/symbol_resolver.h"' not in s and '#include "infra/symbol_resolver.c"' not in s:
+    # dispatch.c 无 include 区，用 extern 声明替代
+    s = ("extern int ksu_lookup_kernel_symbols(const char *const *names, unsigned long *addrs, u32 count);\n\n" + s)
+
+# 2) do_lookup_symbols 处理器：插在 do_disable_escape_to_root 定义前
+handler = '''/*
+ * Batch resolve kernel image symbols (exported or not) for userspace
+ * module symbol binding, ported from SukiSU-Nova main (UAPI 6).
+ */
+static int do_lookup_symbols(void __user *arg)
+{
+    struct ksu_lookup_symbols_cmd cmd;
+    const u64 __user *unames;
+    u64 __user *uaddrs;
+    char **names;
+    unsigned long *addrs;
+    int ret = 0;
+    u32 i;
+
+    if (copy_from_user(&cmd, arg, sizeof(cmd)))
+        return -EFAULT;
+
+    if (cmd.flags) {
+        pr_err("lookup_symbols: unsupported flags 0x%x\\n", cmd.flags);
+        return -EINVAL;
+    }
+    if (!cmd.count || cmd.count > KSU_LOOKUP_SYMBOLS_MAX)
+        return -EINVAL;
+
+    names = kvcalloc(cmd.count, sizeof(*names), GFP_KERNEL);
+    addrs = kvcalloc(cmd.count, sizeof(*addrs), GFP_KERNEL);
+    if (!names || !addrs) {
+        ret = -ENOMEM;
+        goto out;
+    }
+
+    unames = (const u64 __user *)(uintptr_t)cmd.names;
+    uaddrs = (u64 __user *)(uintptr_t)cmd.addrs;
+    for (i = 0; i < cmd.count; i++) {
+        u64 uname;
+        char *name;
+
+        if (get_user(uname, unames + i)) {
+            ret = -EFAULT;
+            goto out;
+        }
+        name = strndup_user((const char __user *)(uintptr_t)uname, KSYM_NAME_LEN);
+        if (IS_ERR(name)) {
+            // An overlong name cannot be a kernel symbol: report it missing.
+            if (PTR_ERR(name) == -EINVAL)
+                continue;
+            ret = PTR_ERR(name);
+            goto out;
+        }
+        if (!*name) {
+            kfree(name);
+            continue;
+        }
+        names[i] = name;
+    }
+
+    ret = ksu_lookup_kernel_symbols((const char *const *)names, addrs, cmd.count);
+    if (ret < 0)
+        goto out;
+
+    for (i = 0; i < cmd.count; i++) {
+        if (put_user((u64)addrs[i], uaddrs + i)) {
+            ret = -EFAULT;
+            goto out;
+        }
+    }
+
+out:
+    if (names) {
+        for (i = 0; i < cmd.count; i++)
+            kfree(names[i]);
+    }
+    kvfree(names);
+    kvfree(addrs);
+    return ret;
+}
+
+'''
+anchor = "static int do_disable_escape_to_root(void __user *arg)"
+if anchor not in s:
+    print("::error::dispatch.c 缺少 do_disable_escape_to_root 锚点，无法插入 do_lookup_symbols")
+    sys.exit(1)
+s = s.replace(anchor, handler + anchor, 1)
+
+# 3) ioctl 表项：插在 LOOKUP_SYMBOLS 可用前提下，DISABLE_ESCAPE_TO_ROOT 表项之后
+entry = '''    {
+        .cmd = KSU_IOCTL_LOOKUP_SYMBOLS,
+        .name = "LOOKUP_SYMBOLS",
+        .handler = do_lookup_symbols,
+        .perm_check = only_root
+    },
+'''
+anchor2 = re.search(r"\.cmd = KSU_IOCTL_DISABLE_ESCAPE_TO_ROOT,(?:.*\n)*?    \},\n", s)
+if not anchor2:
+    print("::error::dispatch.c 处理表缺少 DISABLE_ESCAPE_TO_ROOT 锚点")
+    sys.exit(1)
+s = s[:anchor2.end()] + entry + s[anchor2.end():]
+
+open(path, "w", encoding="utf-8", errors="surrogateescape").write(s)
+print("dispatch.c: do_lookup_symbols 处理器 + LOOKUP_SYMBOLS 表项已接线")
+PYEOF2
+      grep -q 'do_lookup_symbols' "$DISPATCH" || fail "dispatch.c 接线后校验失败"
+    else
+      echo "dispatch.c 已包含 do_lookup_symbols，跳过接线"
+    fi
+
+    # builtin 以 ksu.c unity build 编译（所有 .c 经 #include 聚合进 ksu.o），
+    # resolver 源码必须 #include 进 ksu.c，否则链接报 undefined symbol。
+    KSU_C="$KSU_DIR/kernel/ksu.c"
+    if [ -f "$KSU_C" ] && ! grep -q '#include "infra/symbol_resolver.c"' "$KSU_C"; then
+      sed -i 's|^#include "infra/event_queue.c"|#include "infra/event_queue.c"\n#include "infra/symbol_resolver.c"|' "$KSU_C" \
+        || fail "ksu.c include symbol_resolver.c 失败"
+      grep -q '#include "infra/symbol_resolver.c"' "$KSU_C" || fail "ksu.c symbol_resolver.c include 校验失败"
+      echo "ksu.c: #include infra/symbol_resolver.c 已接入（unity build）"
+    elif [ -f "$KSU_C" ]; then
+      echo "ksu.c 已包含 symbol_resolver.c include，跳过"
+    fi
+
+    # 初始化接线：resolver 的函数指针表需在 kernelsu_init 中初始化
+    if ! grep -q 'ksu_init_symbol_resolver' "$KSU_C" 2>/dev/null; then
+      python3 - "$KSU_C" <<'PYEOF3'
+import sys, re
+path = sys.argv[1]
+s = open(path, encoding="utf-8", errors="surrogateescape").read()
+if "ksu_init_symbol_resolver();" not in s:
+    anchor = "    ksu_supercalls_init();"
+    if anchor in s:
+        s = s.replace(anchor, anchor + "\n\n    ksu_init_symbol_resolver();", 1)
+        open(path, "w", encoding="utf-8", errors="surrogateescape").write(s)
+        print("ksu.c: ksu_init_symbol_resolver() 已接入 kernelsu_init")
+    else:
+        print("::warning::ksu.c 缺少 ksu_supercalls_init 锚点，resolver 初始化未接线（LOOKUP_SYMBOLS 将退化为未初始化 walker）")
+else:
+    print("ksu.c 已包含 ksu_init_symbol_resolver() 调用，跳过")
+PYEOF3
+    else
+      echo "ksu.c 已包含 ksu_init_symbol_resolver() 调用，跳过"
+    fi
+  fi
+else
+  echo "UAPI < 6 无 LOOKUP_SYMBOLS，跳过内核侧能力注入"
+fi
+
+FINAL_UAPI=$(read_uapi "$UAPI_FILE")
+[ "${FINAL_UAPI:-0}" -eq "$MAIN_UAPI" ] || fail "UAPI 号校验失败（期望 $MAIN_UAPI，实际 ${FINAL_UAPI:-未知}）"
+echo "UAPI 同步完成：builtin 检出 UAPI $CUR_UAPI -> $FINAL_UAPI（官方 main $MAIN_UAPI）"
+rm -f "$MAIN_FILE"
diff --git a/scripts/net_compat/add_tcp_snd_cwnd.py b/scripts/net_compat/add_tcp_snd_cwnd.py
new file mode 100644
index 0000000..280c943
--- /dev/null
+++ b/scripts/net_compat/add_tcp_snd_cwnd.py
@@ -0,0 +1,50 @@
+#!/usr/bin/env python3
+"""Add tcp_snd_cwnd accessors to kernels that predate their stable backport.
+
+BBRv3 uses tcp_snd_cwnd()/tcp_snd_cwnd_set(); 5.15.41 and older 5.15
+kernels do not provide them yet. The 5.10 BBRv3 patch already carries
+the same helpers, so this is only needed for kernels where they are
+missing.
+"""
+
+import pathlib
+import sys
+
+HEADER = pathlib.Path("include/net/tcp.h")
+ANCHOR = "static inline bool tcp_in_slow_start(const struct tcp_sock *tp)\n"
+
+HELPERS = (
+    "static inline u32 tcp_snd_cwnd(const struct tcp_sock *tp)\n"
+    "{\n"
+    "\treturn tp->snd_cwnd;\n"
+    "}\n"
+    "\n"
+    "static inline void tcp_snd_cwnd_set(struct tcp_sock *tp, u32 val)\n"
+    "{\n"
+    "\tWARN_ON_ONCE((int)val <= 0);\n"
+    "\ttp->snd_cwnd = val;\n"
+    "}\n"
+    "\n"
+)
+
+
+def main() -> int:
+    if not HEADER.is_file():
+        print("include/net/tcp.h not found", file=sys.stderr)
+        return 1
+
+    text = HEADER.read_text(encoding="utf-8")
+    if "tcp_snd_cwnd" in text:
+        print("tcp_snd_cwnd helpers already present")
+        return 0
+    if ANCHOR not in text:
+        print("anchor tcp_in_slow_start() not found in include/net/tcp.h", file=sys.stderr)
+        return 1
+
+    HEADER.write_text(text.replace(ANCHOR, HELPERS + ANCHOR, 1), encoding="utf-8")
+    print("added tcp_snd_cwnd helpers")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/scripts/ntsync_compat/ntsync_lockdep_compat.h b/scripts/ntsync_compat/ntsync_lockdep_compat.h
new file mode 100644
index 0000000..749509e
--- /dev/null
+++ b/scripts/ntsync_compat/ntsync_lockdep_compat.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * ntsync_lockdep_compat.h - lockdep glue for pre-v5.13 kernels
+ *
+ * drivers/misc/ntsync.c relies on the generic assertion API introduced by
+ * the v5.13 lockdep rework:
+ *
+ *   lockdep_assert(cond)
+ *   LOCK_STATE_UNKNOWN / LOCK_STATE_NOT_HELD / LOCK_STATE_HELD
+ *
+ * The upstream platform patch backports that rework wholesale, but its
+ * include/linux/lockdep.h hunk also expects lockdep_assert_none_held_once(),
+ * which does not exist before v5.13. On 5.10 the hunk is rejected while
+ * kernel/locking/lockdep.c is patched anyway, leaving a tree that cannot
+ * compile.
+ *
+ * This header provides only the two symbols the driver actually uses, so old
+ * kernels keep their core locking code untouched. Semantics match upstream:
+ * lockdep_is_held() reports 1/0 (or -1 when lockdep is disabled), therefore
+ * "!= LOCK_STATE_NOT_HELD" keeps the upstream meaning in every case.
+ */
+#ifndef _NTSYNC_LOCKDEP_COMPAT_H
+#define _NTSYNC_LOCKDEP_COMPAT_H
+
+#include <linux/bug.h>
+#include <linux/lockdep.h>
+
+#ifndef LOCK_STATE_NOT_HELD
+#define LOCK_STATE_UNKNOWN	(-1)
+#define LOCK_STATE_NOT_HELD	0
+#define LOCK_STATE_HELD		1
+#endif
+
+#ifndef lockdep_assert
+#ifdef CONFIG_LOCKDEP
+#define lockdep_assert(cond)	do { WARN_ON(debug_locks && !(cond)); } while (0)
+#else
+#define lockdep_assert(cond)	do { } while (0)
+#endif
+#endif
+
+#endif /* _NTSYNC_LOCKDEP_COMPAT_H */
diff --git a/scripts/sukisu_compat/apply.sh b/scripts/sukisu_compat/apply.sh
new file mode 100644
index 0000000..9b71cd2
--- /dev/null
+++ b/scripts/sukisu_compat/apply.sh
@@ -0,0 +1,208 @@
+#!/usr/bin/env bash
+# SukiSU-Nova 内核源码 API 兼容补丁（SukiSU-Nova builtin / main 分支均适用）
+#
+# 背景：
+#   1) builtin 分支 kernel/hook/lsm_hook.c 仍以旧签名
+#      security_add_hooks(hooks, count, "ksu") 注册 LSM 钩子，
+#      6.8+ 内核要求 (hooks, count, const struct lsm_id *)，
+#      android16-6.12 GKI 编译报 -Wincompatible-pointer-types（-Werror）；
+#   2) builtin 在 app 启动路径对管理器/授权应用 disable_seccomp()，
+#      管理器首页 "Seccomp 状态" 显示"未启用"；改为对齐 main 分支/BakaSU
+#      的过滤模式（保留 seccomp 过滤器 + action cache 放行 reboot）。
+#
+# 已由上游修复、本仓库随之移除的适配（核对 builtin 5ef32ad / main 31255c4）：
+#   - arch.h 缺失：builtin 已自带 kernel/arch.h（与本仓库旧副本逐字节一致）
+#   - EVENT_SERVICES 缺失 / rules.c 重复声明：builtin 已随 UAPI 6 同步修复
+#   - pkg_observer 的 track_throne(TRACK_THRONE_FORCE_SYNCHRONOUS)：已改回 false
+#   - supercall.h 的 KSU_IOCTL_KPM 笔误 / KSU_IOCTL_MANAGER 缺声明：
+#     上游已把 KPM / MANAGER 等并入统一的 KSU_IOCTL_EXTENSION，旧常量不复存在
+#   - throne_tracker 的 crown_manager 裸 return / pkg 作用域：上游已修正
+#   - netlink_kernel_cfg.cb_mutex（Linux 6.11 移除）：上游已改为构建期探测
+#     目标 netlink.h 并定义 KSU_NETLINK_CFG_HAS_CB_MUTEX，super_access.c
+#     以 #ifdef 守卫该成员（main: kernel/Kbuild / builtin: kernel/Makefile）
+#
+# 修复均以内容检测守卫，上游自行修复后自动跳过，重复执行幂等。
+#
+# 用法: apply.sh [KernelSU 目录]（调用方工作目录需为 $KERNEL_ROOT）
+
+set -eo pipefail
+
+KSU_DIR="${1:-KernelSU}"
+
+fail() {
+  if [ "$SKIP_INCOMPATIBLE" = "true" ]; then
+    echo "::warning title=SukiSU-Nova 兼容补丁已跳过::$1"
+    if [ -n "${GITHUB_STEP_SUMMARY:-}" ]; then
+      echo "" >> "$GITHUB_STEP_SUMMARY"
+      echo "> ⏭️ **SukiSU-Nova API 兼容补丁** 已自动跳过：$1（构建未中断）" >> "$GITHUB_STEP_SUMMARY"
+    fi
+    exit 0
+  fi
+  echo "::error::$1"
+  exit 1
+}
+
+[ -d "$KSU_DIR" ] || fail "未找到 KernelSU 目录: $KSU_DIR"
+
+COMPAT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+LSM_FILE="$KSU_DIR/kernel/hook/lsm_hook.c"
+if [ -f "$LSM_FILE" ] && grep -q 'security_add_hooks(ksu_hooks, ARRAY_SIZE(ksu_hooks), "ksu");' "$LSM_FILE"; then
+  if grep -q 'ksu_lsm_id' "$LSM_FILE"; then
+    echo "lsm_hook.c 已包含 lsm_id 兼容代码，跳过"
+  else
+    echo "应用 lsm_id 兼容补丁 (6.8+ security_add_hooks 新签名)..."
+    patch -p1 --forward -d "$KSU_DIR" < "$COMPAT_DIR/sukisu-lsm-id-6.8.patch" \
+      || fail "lsm_id 兼容补丁应用失败（SukiSU-Nova 上游代码可能已变化）"
+    grep -q 'struct lsm_id ksu_lsm_id' "$LSM_FILE" \
+      || fail "lsm_id 兼容补丁应用后校验失败"
+    echo "lsm_hook.c: 6.8+ 已切换为 struct lsm_id 注册"
+  fi
+else
+  echo "lsm_hook.c 不存在或无需 lsm_id 兼容补丁，跳过"
+fi
+
+# ---- Seccomp 过滤模式（builtin 分支）----
+# 背景：builtin 分支在 app 启动路径（zygote setresuid 钩子）对管理器与授权
+# 应用直接调用 disable_seccomp()，管理器进程自身的 seccomp 过滤器被清除，
+# 管理器首页 "Seccomp 状态" 显示"未启用"。main 分支 / BakaSU 的对应实现是
+# 保留过滤器（"过滤模式"），仅通过 seccomp action cache（GKI 5.10+ backport）
+# 放行 reboot。
+# 处理：改写 lsm_hook.c 的 6 处 disable_seccomp() 调用点为 cache-allow 形式，
+# 分发 infra/seccomp_cache.c/h 并在 ksu.c（上游重构后为 ksu_main.c）聚合编译；>=5.10 保留过滤器，
+# <5.10 维持 disable_seccomp() 原行为（action cache 不存在）。
+# 守卫：仅命中 builtin 的 handle_zygote_setresuid 时执行，main 分支自动跳过；
+# 上游自行修复后幂等跳过。
+if [ -f "$LSM_FILE" ] && grep -q 'handle_zygote_setresuid' "$LSM_FILE"; then
+  if grep -q 'ksu_seccomp_allow_cache' "$LSM_FILE"; then
+    echo "lsm_hook.c 已包含 seccomp 过滤模式逻辑，跳过"
+  else
+    echo "应用 seccomp 过滤模式补丁 (对齐 main 分支/BakaSU：管理器与授权应用保留 seccomp 过滤器)..."
+    [ -d "$KSU_DIR/kernel/infra" ] || fail "未找到 $KSU_DIR/kernel/infra 目录，SukiSU-Nova builtin 结构可能已变化"
+    cp "$COMPAT_DIR/seccomp_cache.h" "$KSU_DIR/kernel/infra/seccomp_cache.h" \
+      || fail "seccomp_cache.h 分发失败"
+    cp "$COMPAT_DIR/seccomp_cache.c" "$KSU_DIR/kernel/infra/seccomp_cache.c" \
+      || fail "seccomp_cache.c 分发失败"
+    python3 "$COMPAT_DIR/seccomp_filter_mode.py" "$KSU_DIR" \
+      || fail "seccomp 过滤模式补丁应用失败（SukiSU-Nova builtin 上游代码可能已变化）"
+    grep -q 'ksu_seccomp_allow_cache' "$LSM_FILE" \
+      || fail "seccomp 过滤模式补丁应用后校验失败 (lsm_hook.c)"
+    # 聚合编译文件随上游重构更名（kernel/ksu.c -> kernel/ksu_main.c），按实际路径校验
+    KSU_AGG=""
+    for cand in kernel/ksu.c kernel/ksu_main.c; do
+      if [ -f "$KSU_DIR/$cand" ]; then
+        KSU_AGG="$KSU_DIR/$cand"
+        break
+      fi
+    done
+    if [ -z "$KSU_AGG" ] || ! grep -q '#include "infra/seccomp_cache.c"' "$KSU_AGG"; then
+      fail "seccomp 过滤模式补丁应用后校验失败 (聚合编译文件 ksu.c/ksu_main.c)"
+    fi
+    grep -q '#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)' "$KSU_DIR/kernel/infra/seccomp_cache.c" \
+      || fail "seccomp_cache.c 版本守卫校验失败"
+    echo "seccomp 过滤模式已启用：管理器首页 Seccomp 状态将显示\"过滤模式\""
+  fi
+else
+  echo "lsm_hook.c 无 builtin setresuid 路径（main 分支已内置过滤模式），跳过 seccomp 过滤模式补丁"
+fi
+
+# ---- clang fall-through annotation ----
+# builtin 的 policy/allowlist.c 使用注释形式 fall-through；bazel GKI
+# 构建开启 -Werror,-Wimplicit-fallthrough 时会直接报错。改用内核
+# fallthrough 宏（展开为 __attribute__((__fallthrough__))），上游修复后自动跳过。
+if grep -rqF '/* fall through */' "$KSU_DIR/kernel" 2>/dev/null; then
+  echo "修正 SukiSU-Nova 源码的注释式 fall-through（bazel -Werror 兼容）..."
+  python3 - "$KSU_DIR" <<'PYEOF'
+import pathlib
+import sys
+
+root = pathlib.Path(sys.argv[1]) / "kernel"
+for path in sorted(root.rglob("*.c")):
+    text = path.read_text(encoding="utf-8", errors="surrogateescape")
+    if "/* fall through */" not in text:
+        continue
+    path.write_text(
+        text.replace("/* fall through */", "fallthrough;"),
+        encoding="utf-8",
+        errors="surrogateescape",
+    )
+    print(f"  {path}")
+PYEOF
+  if grep -rqF '/* fall through */' "$KSU_DIR/kernel" 2>/dev/null; then
+    fail "fall-through 注解修正后仍有残留"
+  fi
+  echo "fall-through 注解修正完成"
+else
+  echo "SukiSU-Nova 源码无注释式 fall-through，跳过"
+fi
+
+# ---- 6.12+ LSM 静态调用槽位（builtin 分支）----
+# 背景：6.12 的 LSM 框架把每个 hook 的回调预先编成 static call 表，
+#   表宽是编译期算出的 MAX_LSM_COUNT（= 内建 LSM 数量）。
+#   security_add_hooks() 里 lsm_active_cnt >= MAX_LSM_COUNT 直接
+#   panic("Too many LSMs registered")。
+#   GKI 的 gki_defconfig 恰好启用 5 个 LSM
+#   （capabilities/selinux/safesetid/bpf_lsm/landlock），
+#   MAX_LSM_COUNT == 5 且开机时全部注册，没有空位。
+#   builtin 分支的 hook/lsm_hook.c 仍在 device_initcall 阶段用
+#   security_add_hooks() 注册自己的 LSM（main/FinaSU 已改为运行期改写
+#   static call 槽位，不占新位），于是第 6 个 LSM 触发上述 panic：
+#   刷入后停在开机第一屏、panic 后不落盘任何日志（PANIC_TIMEOUT=-1）。
+# 处理：给 MAX_LSM_COUNT 预留一个显式的 KSU 槽位（KSU_ENABLED 1,）。
+#   static call 表随之加宽一列，KSU 注册时能拿到空闲槽位。
+# 守卫：仅当内核启用 static call LSM 框架（security/security.c 含上述 panic）
+#   且 KSU 驱动仍调用 security_add_hooks() 时执行；上游改用槽位改写后自动跳过。
+LSM_ROOT="${KERNEL_ROOT:-.}"
+LSM_COUNT_FILE="$LSM_ROOT/common/include/linux/lsm_count.h"
+LSM_PANIC_GUARD="$LSM_ROOT/common/security/security.c"
+if [ -f "$LSM_COUNT_FILE" ] && [ -f "$LSM_PANIC_GUARD" ] \
+  && grep -qs 'Too many LSMs registered' "$LSM_PANIC_GUARD" \
+  && grep -qs 'security_add_hooks(ksu_hooks' "$KSU_DIR/kernel/hook/lsm_hook.c"; then
+  if grep -q 'KSU_ENABLED' "$LSM_COUNT_FILE"; then
+    echo "lsm_count.h 已含 KSU 槽位，跳过"
+  else
+    echo "为内建 KSU 预留 LSM static call 槽位 (MAX_LSM_COUNT +1)..."
+    python3 - "$LSM_COUNT_FILE" <<'PYEOF'
+import sys
+
+path = sys.argv[1]
+text = open(path, encoding="utf-8", errors="surrogateescape").read()
+
+block = """/*
+ * KernelSU registers its own LSM from device_initcall, after every built-in
+ * LSM has taken its static call slot. Reserve one extra column so that
+ * security_add_hooks() finds a free slot instead of panicking with
+ * "Too many LSMs registered".
+ */
+#if IS_ENABLED(CONFIG_KSU)
+#define KSU_ENABLED 1,
+#else
+#define KSU_ENABLED
+#endif
+
+"""
+
+anchor = "#define MAX_LSM_COUNT"
+idx = text.find(anchor)
+if idx < 0:
+    sys.exit("MAX_LSM_COUNT not found")
+
+text = text[:idx] + block + text[idx:]
+
+open_brace = text.find("COUNT_LSMS(", idx)
+if open_brace < 0:
+    sys.exit("COUNT_LSMS not found")
+line_end = text.find("\n", open_brace)
+text = text[:line_end + 1] + "\t\tKSU_ENABLED\t\t\\\n" + text[line_end + 1:]
+
+open(path, "w", encoding="utf-8", errors="surrogateescape").write(text)
+print("  lsm_count.h: MAX_LSM_COUNT 已为 KSU 增加一列")
+PYEOF
+    grep -q 'KSU_ENABLED' "$LSM_COUNT_FILE" \
+      || fail "lsm_count.h 增加 KSU 槽位后校验失败"
+  fi
+else
+  echo "内核无 lsm_count.h 或 KSU 未用 security_add_hooks，跳过 LSM 槽位预留"
+fi
+
+echo "SukiSU-Nova API 兼容补丁处理完成"
diff --git a/scripts/sukisu_compat/seccomp_cache.c b/scripts/sukisu_compat/seccomp_cache.c
new file mode 100644
index 0000000..0938b72
--- /dev/null
+++ b/scripts/sukisu_compat/seccomp_cache.c
@@ -0,0 +1,67 @@
+#include <linux/version.h>
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0)
+#include <linux/fs.h>
+#include <linux/sched/task.h>
+#include <linux/uaccess.h>
+#include <linux/filter.h>
+#include <linux/seccomp.h>
+#include "klog.h" // IWYU pragma: keep
+#include "infra/seccomp_cache.h"
+
+struct action_cache {
+    DECLARE_BITMAP(allow_native, SECCOMP_ARCH_NATIVE_NR);
+#ifdef SECCOMP_ARCH_COMPAT
+    DECLARE_BITMAP(allow_compat, SECCOMP_ARCH_COMPAT_NR);
+#endif
+};
+
+struct seccomp_filter {
+    refcount_t refs;
+    refcount_t users;
+    bool log;
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+    bool wait_killable_recv;
+#endif
+    struct action_cache cache;
+    struct seccomp_filter *prev;
+    struct bpf_prog *prog;
+    struct notification *notif;
+    struct mutex notify_lock;
+    wait_queue_head_t wqh;
+};
+
+void ksu_seccomp_clear_cache(struct seccomp_filter *filter, int nr)
+{
+    if (!filter) {
+        return;
+    }
+
+    if (nr >= 0 && nr < SECCOMP_ARCH_NATIVE_NR) {
+        clear_bit(nr, filter->cache.allow_native);
+    }
+
+#ifdef SECCOMP_ARCH_COMPAT
+    if (nr >= 0 && nr < SECCOMP_ARCH_COMPAT_NR) {
+        clear_bit(nr, filter->cache.allow_compat);
+    }
+#endif
+}
+
+void ksu_seccomp_allow_cache(struct seccomp_filter *filter, int nr)
+{
+    if (!filter) {
+        return;
+    }
+
+    if (nr >= 0 && nr < SECCOMP_ARCH_NATIVE_NR) {
+        set_bit(nr, filter->cache.allow_native);
+    }
+
+#ifdef SECCOMP_ARCH_COMPAT
+    if (nr >= 0 && nr < SECCOMP_ARCH_COMPAT_NR) {
+        set_bit(nr, filter->cache.allow_compat);
+    }
+#endif
+}
+#endif
