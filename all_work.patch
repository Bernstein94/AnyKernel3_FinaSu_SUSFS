+name: 内核构建流程
+
+permissions:
+  contents: write
+  actions: write
+
+on:
+  workflow_call:
+    inputs:
+      # ==================== 基础配置 ====================
+      android_version:
+        required: true
+        type: string
+      kernel_version:
+        required: true
+        type: string
+      sub_level:
+        required: true
+        type: string
+      display_sub:
+        description: "LTS 构建的展示用子版本号（数据管线维护，仅用于运行/作业命名）"
+        required: false
+        type: string
+        default: ""
+      os_patch_level:
+        required: true
+        type: string
+
+      # ==================== KernelSU 配置 ====================
+      ksu_variant:
+        required: true
+        type: string
+      build_channel:
+        description: "构建通道：正式 (Release) 对齐官方发行版；最新 (HEAD) 跟随上游最新提交（仅用于标识与摘要）"
+        required: false
+        type: string
+        default: "正式 (Release)"
+      ksu_commit:
+        description: "BakaSU 专用：KernelSU 检出到该提交以对齐官方最新上传构建（留空跟随 main HEAD）"
+        required: false
+        type: string
+        default: ""
+      ksu_cert_size:
+        description: "FinaSU 专用：管理器签名证书 DER 尺寸（0x 十六进制，第二信任槽对齐用）"
+        required: false
+        type: string
+        default: ""
+      ksu_cert_hash:
+        description: "FinaSU 专用：管理器签名证书 SHA256（第二信任槽对齐用）"
+        required: false
+        type: string
+        default: ""
+      manager_ver:
+        description: "管理器 versionCode（如 32730），作为内核命名版本；优先级高于按提交数推导的 KSU_VERSION"
+        required: false
+        type: string
+        default: ""
+
+      # ==================== 可选配置 ====================
+      version:
+        required: false
+        type: string
+      revision:
+        required: false
+        type: string
+        default: "r1"
+      build_time:
+        required: false
+        type: string
+        default: ""
+
+      # ==================== 功能开关 ====================
+      use_zram:
+        required: true
+        type: boolean
+        default: true
+      use_bbg:
+        required: true
+        type: boolean
+        default: true
+      use_net_enhance:
+        required: true
+        type: boolean
+        default: false
+      use_kpm:
+        required: true
+        type: boolean
+        default: false
+      use_rekernel:
+        required: false
+        type: boolean
+        default: false
+      use_nomount:
+        required: false
+        type: boolean
+        default: false
+      cve_2026_43499_patch:
+        required: false
+        type: boolean
+        default: false
+      enable_susfs:
+        required: true
+        type: boolean
+        default: true
+      ksu_mode:
+        required: false
+        type: string
+        default: "关闭"
+      supp_op:
+        required: false
+        type: boolean
+        default: false
+      droidspaces:
+        required: false
+        type: string
+        default: "off"
+      artifact_upload_mode:
+        required: false
+        type: string
+        default: "上传全部"
+      droidspaces_ntsync:
+        required: false
+        type: boolean
+        default: false
+      skip_incompatible:
+        description: "功能不兼容或无法使用时自动跳过该功能（不中断构建）"
+        required: false
+        type: boolean
+        default: true
+
+jobs:
+  build-kernel:
+    name: "${{ inputs.kernel_version }}.${{ inputs.display_sub || inputs.sub_level }}-${{ inputs.android_version }}-${{ inputs.os_patch_level }}-${{ inputs.ksu_variant }}"
+    runs-on: ubuntu-24.04
+    # repo sync 重试（3 x 20 分钟）+ 完整构建需要 60 分钟以上的余量
+    timeout-minutes: 90
+
+    env:
+      CCACHE_COMPILERCHECK: "%compiler% -dumpmachine; %compiler% -dumpversion"
+      CCACHE_NOHASHDIR: "true"
+      CCACHE_HARDLINK: "true"
+      SKIP_INCOMPATIBLE: ${{ inputs.skip_incompatible }}
+
+    steps:
+      - name: 构建信息摘要
+        run: |
+          echo "========================================"
+          echo "       内核构建配置摘要"
+          echo "========================================"
+          echo "Android 版本  : ${{ inputs.android_version }}"
+          echo "内核版本      : ${{ inputs.kernel_version }}"
+          echo "子版本号      : ${{ inputs.sub_level }}"
+          echo "补丁级别      : ${{ inputs.os_patch_level }}"
+          echo "KSU 变体      : ${{ inputs.ksu_variant }}"
+          echo "构建通道      : ${{ inputs.build_channel }}"
+          echo "构建时间      : ${{ inputs.build_time }}"
+          echo "SUSFS 状态    : ${{ inputs.enable_susfs }}"
+          echo "ZRAM 压缩     : ${{ inputs.use_zram }}"
+          echo "BBG 补丁      : ${{ inputs.use_bbg }}"
+          echo "网络增强      : ${{ inputs.use_net_enhance }}"
+          echo "KPM 功能      : ${{ inputs.use_kpm && '开启' || '关闭' }}"
+          echo "NoMount 元模块: ${{ inputs.use_nomount && '开启' || '关闭' }}"
+          echo "Re-Kernel     : ${{ inputs.use_rekernel }}"
+          echo "CVE-2026-43499: ${{ inputs.cve_2026_43499_patch }}"
+          echo "Droidspaces   : ${{ inputs.droidspaces }}"
+          echo "NTSync        : ${{ inputs.droidspaces_ntsync }}"
+          echo "兼容跳过      : ${{ inputs.skip_incompatible }}"
+          echo "产物上传模式  : ${{ inputs.artifact_upload_mode }}"
+          echo "========================================"
+
+      - name: 清理磁盘空间
+        uses: endersonmenezes/free-disk-space@v3
+        with:
+          remove_android: true
+          remove_dotnet: true
+          remove_haskell: true
+          remove_tool_cache: true
+          remove_swap: true
+          remove_packages: "azure-cli google-cloud-cli microsoft-edge-stable google-chrome-stable firefox postgresql* temurin-* *llvm* mysql* dotnet-sdk-*"
+          remove_packages_one_command: true
+          remove_folders: "/usr/share/swift /usr/share/miniconda /usr/share/az* /usr/local/lib/node_modules /usr/local/share/chromium /usr/local/share/powershell /usr/local/julia /usr/local/aws-cli /usr/local/aws-sam-cli /usr/share/gradle"
+          rm_cmd: "rmz"
+          rmz_version: "3.1.1"
