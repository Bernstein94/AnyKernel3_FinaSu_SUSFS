index 0000000..c223bca
--- /dev/null
+++ b/scripts/susfs_fixes/susfs_fake_fdinfo.py
@@ -0,0 +1,139 @@
+#!/usr/bin/env python3
+"""Reshape fs/notify/fdinfo.c so the susfs4ksu 50_add_susfs_in_gki patch applies.
+
+The 5.10/5.15 SUSFS patches carry a hunk whose context is the *post-fake-patch*
+form of inotify_fdinfo():
+
+        if (inode) {
+                seq_printf(m, "inotify wd:%x ino:%lx sdev:%x mask:%x ignored_mask:0 ",
+                           inode_mark->wd, inode->i_ino, inode->i_sb->s_dev,
+                           inotify_mark_user_mask(mark));
+
+Android GKI sources at those sublevels still carry the upstream form: the
+IN_ALL_EVENTS comment block, a local `u32 mask` variable, `ignored_mask:%x`,
+and `mask, mark->ignored_mask` as the last two arguments. While that text is
+present, the hunk's trailing context cannot match and patch reports
+"Hunk #4 FAILED".
+
+Earlier revisions of this transformation used a brace-delimited perl
+substitution (`s{(if \\(inode\\) {\\n)...}{$1}gs`). Perl balances braces inside
+{} delimiters, so the literal `{` in `if (inode) {` desynchronised the parser
+and the substitution died before touching the file - leaving the comment and
+the `u32 mask` line in place and the SUSFS hunk rejecting on every run.
+
+This script performs the same reshape with explicit, anchored regexes and then
+verifies the file really is in the shape the patch expects, so CI fails loudly
+instead of silently shipping a half-applied fake patch.
+
+Usage: susfs_fake_fdinfo.py <path-to-fdinfo.c>
+"""
+
+import re
+import sys
+
+HELPER = """static inline u32 inotify_mark_user_mask(struct fsnotify_mark *mark)
+{
+\treturn mark->mask & IN_ALL_EVENTS;
+}
+"""
+
+# `if (inode) {` followed by the IN_ALL_EVENTS comment block inside
+# inotify_fdinfo(). Only the first occurrence (inotify) is in scope.
+COMMENT_RE = re.compile(
+    r"(if \(inode\) \{\n)[ \t]*/\*.*?\n[ \t]*\*/[ \t]*\n",
+    re.S,
+)
+
+# The local mask variable that becomes dead once the helper is used.
+MASK_DECL_RE = re.compile(r"^[ \t]*u32 mask = mark->mask & IN_ALL_EVENTS;\n", re.M)
+
+# The inotify seq_printf call, in its upstream form.
+INOTIFY_CALL_RE = re.compile(
+    r"(?P<ind>[ \t]*)seq_printf\(m, \"inotify wd:%x ino:%lx sdev:%x mask:%x "
+    r"ignored_mask:%x \",\n"
+    r"(?P<cont>[ \t]*)inode_mark->wd, inode->i_ino, inode->i_sb->s_dev,\n"
+    r"[ \t]*mask, mark->ignored_mask\);",
+)
+
+# The same call in the form the SUSFS hunk expects (used for validation and
+# for idempotent re-runs).
+TARGET_CALL_RE = re.compile(
+    r"seq_printf\(m, \"inotify wd:%x ino:%lx sdev:%x mask:%x ignored_mask:0 \",\n"
+    r"[ \t]*inode_mark->wd, inode->i_ino, inode->i_sb->s_dev,\n"
+    r"[ \t]*inotify_mark_user_mask\(mark\)\);",
+)
+
+FDINFO_DECL_RE = re.compile(
+    r"^static void inotify_fdinfo\(struct seq_file \*m, struct fsnotify_mark \*mark\)$",
+    re.M,
+)
+HELPER_DECL_RE = re.compile(
+    r"^static inline u32 inotify_mark_user_mask\(struct fsnotify_mark \*mark\)$", re.M
+)
+
+
+def shape_ok(src):
+    """True when the file already matches what the SUSFS hunk expects."""
+    return bool(TARGET_CALL_RE.search(src)) and not MASK_DECL_RE.search(src)
+
+
+def main(path):
+    with open(path) as fh:
+        src = fh.read()
+
+    if not FDINFO_DECL_RE.search(src):
+        sys.exit("%s: inotify_fdinfo() not found - refusing to touch it" % path)
+
+    if shape_ok(src):
+        print("%s: already in SUSFS shape, nothing to do" % path)
+        return
+
+    out = src
+    notes = []
+
+    # 1. Drop the upstream IN_ALL_EVENTS comment block inside inotify_fdinfo().
+    out, n = COMMENT_RE.subn(r"\1", out, count=1)
+    if n:
+        notes.append("removed IN_ALL_EVENTS comment")
+
+    # 2. Drop the now-unused local mask variable.
+    out, n = MASK_DECL_RE.subn("", out, count=1)
+    if n:
+        notes.append("removed u32 mask declaration")
+
+    # 3. Rewrite the inotify seq_printf: ignored_mask always prints as 0 and
+    #    the printed mask comes from the helper the patch's context expects.
+    def _call(m):
+        return (
+            '%sseq_printf(m, "inotify wd:%%x ino:%%lx sdev:%%x mask:%%x '
+            'ignored_mask:0 ",\n'
+            "%sinode_mark->wd, inode->i_ino, inode->i_sb->s_dev,\n"
+            "%sinotify_mark_user_mask(mark));"
+            % (m.group("ind"), m.group("cont"), m.group("cont"))
+        )
+
+    out, n = INOTIFY_CALL_RE.subn(_call, out, count=1)
+    if n:
+        notes.append("rewrote inotify seq_printf")
+
+    # 4. Provide the helper definition the patch's context assumes exists.
+    if not HELPER_DECL_RE.search(out):
+        out = FDINFO_DECL_RE.sub(lambda m: HELPER + "\n" + m.group(0), out, count=1)
+        notes.append("inserted inotify_mark_user_mask helper")
+
+    # 5. Never write a file that still fails the patch's expectations.
+    if not shape_ok(out):
+        sys.exit(
+            "%s: could not reshape fdinfo.c (applied: %s); refusing to continue"
+            % (path, "; ".join(notes) or "nothing")
+        )
+
+    with open(path, "w") as fh:
+        fh.write(out)
+    print("%s: %s" % (path, "; ".join(notes)))
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 2:
+        sys.exit(__doc__)
+    main(sys.argv[1])
diff --git a/scripts/susfs_fixes/susfs_fdinfo_fanotify_arity.py b/scripts/susfs_fixes/susfs_fdinfo_fanotify_arity.py
new file mode 100644
index 0000000..6d6c918
--- /dev/null
+++ b/scripts/susfs_fixes/susfs_fdinfo_fanotify_arity.py
@@ -0,0 +1,93 @@
+#!/usr/bin/env python3
+"""Fix fanotify_fdinfo() arity in fs/notify/fdinfo.c after the SUSFS patch.
+
+The 5.10/5.15/6.1 SUSFS patches widen show_fdinfo() to a 3-argument callback
+when SUS_MOUNT or SUS_KSTAT is on:
+
+    #if defined(CONFIG_KSU_SUSFS_SUS_MOUNT) || defined(CONFIG_KSU_SUSFS_SUS_KSTAT)
+    static void show_fdinfo(struct seq_file *m, struct file *f,
+                            void (*show)(struct seq_file *m,
+                                         struct fsnotify_mark *mark,
+                                         struct file *file))
+    ...
+            show(m, mark, f);
+
+They adapt the inotify callbacks to that shape but not the fanotify one, so
+fanotify_fdinfo() stays 2-argument. That is invisible while CONFIG_FANOTIFY=n,
+because the whole block compiles out. With fanotify enabled it is a hard error:
+
+    fs/notify/fdinfo.c:221:20: error: incompatible function pointer types passing
+      'void (struct seq_file *, struct fsnotify_mark *)' to parameter of type
+      'void (*)(struct seq_file *, struct fsnotify_mark *, struct file *)'
+
+Add the missing `struct file *file` parameter to fanotify_fdinfo() whenever
+show_fdinfo() is in the widened form. The parameter is unused by design (the
+inotify side is what needs `file` for sus_mount path resolution), and the kernel
+does not build with -Wunused-parameter.
+
+Idempotent, anchored, fails loudly if the file is in neither expected shape.
+
+Usage: susfs_fdinfo_fanotify_arity.py <kernel/common>
+"""
+
+import os
+import re
+import sys
+from typing import NoReturn
+
+WIDE_SHOW = re.compile(
+    r"static void show_fdinfo\(struct seq_file \*m, struct file \*f,\s*\n"
+    r"\s*void \(\*show\)\(struct seq_file \*m,\s*\n"
+    r"\s*struct fsnotify_mark \*mark,\s*\n"
+    r"\s*struct file \*file\)\)"
+)
+FAN_2ARG = re.compile(
+    r"static void fanotify_fdinfo\(struct seq_file \*m, struct fsnotify_mark \*mark\)"
+)
+FAN_3ARG = re.compile(
+    r"static void fanotify_fdinfo\(struct seq_file \*m, struct fsnotify_mark \*mark,"
+    r"\s*\n?\s*struct file \*file\)"
+)
+
+
+def die(msg: str) -> NoReturn:
+    sys.exit(f"ERROR: {msg}")
+
+
+def main() -> None:
+    if len(sys.argv) != 2:
+        die("usage: susfs_fdinfo_fanotify_arity.py <kernel/common>")
+    path = os.path.join(sys.argv[1].rstrip("/"), "fs/notify/fdinfo.c")
+    if not os.path.exists(path):
+        print("  fdinfo.c: not present (nothing to do)")
+        return
+
+    src = open(path, encoding="utf-8").read()
+
+    if not WIDE_SHOW.search(src):
+        print("  fdinfo.c: show_fdinfo() is not widened - nothing to do")
+        return
+    if FAN_3ARG.search(src):
+        print("  fdinfo.c: fanotify_fdinfo() already takes file")
+        return
+    if not FAN_2ARG.search(src):
+        # fanotify may be compiled out of this tree entirely.
+        print("  fdinfo.c: no 2-argument fanotify_fdinfo() found - nothing to do")
+        return
+
+    src = FAN_2ARG.sub(
+        "static void fanotify_fdinfo(struct seq_file *m, struct fsnotify_mark *mark,\n"
+        "\t\t\t     struct file *file)",
+        src,
+        count=1,
+    )
+    open(path, "w", encoding="utf-8").write(src)
+
+    check = open(path, encoding="utf-8").read()
+    if not FAN_3ARG.search(check):
+        die("fdinfo.c: fanotify_fdinfo() still 2-argument after rewrite")
+    print("  fdinfo.c: fanotify_fdinfo() widened to match show_fdinfo()")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/susfs_fixes/susfs_guard_priority_helpers.py b/scripts/susfs_fixes/susfs_guard_priority_helpers.py
new file mode 100644
index 0000000..d06696e
--- /dev/null
+++ b/scripts/susfs_fixes/susfs_guard_priority_helpers.py
@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+"""Keep the SUSFS credential helpers compiling whether or not the priority-uid
+filter is enabled.
+
+fs/susfs.c defines two static helpers:
+
+  static struct cred *susfs_switch_to_ksu_domain(void)
+  static void susfs_restore_creds(struct cred *orig_cred)
+
+When they were introduced, only the priority-uid-filter switch called them, so
+a tree without CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER - BakaSU's Kconfig has no
+such symbol at all, so olddefconfig drops the entry - compiled them as dead
+code and GKI's -Werror killed the build:
+
+  fs/susfs.c:183:21: error: unused function 'susfs_switch_to_ksu_domain'
+  fs/susfs.c:217:13: error: unused function 'susfs_restore_creds'
+
+The old fix wrapped the definitions in the same config guard. That is now wrong:
+the sus_path uid filter path calls susfs_restore_creds as well (the
+susfs_sus_path_app_strings worker's error exits), so with the guard in place and
+the priority symbol off, the definition disappears while those calls remain:
+
+  fs/susfs.c:779:2: error: call to undeclared function 'susfs_restore_creds'
+
+__maybe_unused solves both directions: the helpers stay visible to every caller,
+and a build where nothing calls them no longer trips -Wunused-function. Any
+guard this script added earlier is removed, so re-running on an already-patched
+tree upgrades it.
+
+Idempotent, anchor-checked.
+
+Usage: susfs_guard_priority_helpers.py <path-to-fs/susfs.c>
+"""
+
+import os
+import sys
+from typing import NoReturn
+
+GUARD = "#ifdef CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER\n"
+ENDIF = "#endif // #ifdef CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER /* credential helpers */\n"
+
+SWITCH_SIG = "static struct cred *susfs_switch_to_ksu_domain(void) {"
+SWITCH_NEW = "static struct cred * __maybe_unused susfs_switch_to_ksu_domain(void) {"
+RESTORE_SIG = "static void susfs_restore_creds(struct cred *orig_cred) {"
+RESTORE_NEW = "static void __maybe_unused susfs_restore_creds(struct cred *orig_cred) {"
+DOC_START = " * Switches the selinux domain of the current process to the KernelSU one"
+
+
+def die(msg: str) -> NoReturn:
+    sys.exit(f"ERROR: {msg}")
+
+
+def main() -> None:
+    if len(sys.argv) != 2:
+        die("usage: susfs_guard_priority_helpers.py <path-to-fs/susfs.c>")
+    path = sys.argv[1]
+    if not os.path.exists(path):
+        die(f"{path}: not found")
+    src = open(path, encoding="utf-8").read()
+    original = src
+    notes = []
+
+    # Upgrade path: undo the guard this script used to insert. It has to be
+    # removed surgically - upstream has its own, legitimate
+    # "#ifdef CONFIG_KSU_SUSFS_PRIORITY_UID_FILTER" around the switch block
+    # (~line 1785), and removing every occurrence would delete real code.
+    if ENDIF in src:
+        src = src.replace(ENDIF, "", 1)
+        doc_at = src.find(DOC_START)
+        if doc_at > 0:
+            guard_at = src.rfind(GUARD, 0, doc_at)
+            between = src[guard_at + len(GUARD):doc_at] if guard_at >= 0 else None
+            if between is not None and between.strip() in ("/*", ""):
+                src = src[:guard_at] + src[guard_at + len(GUARD):]
+                notes.append("removed our guard around the credential helpers")
+            else:
+                notes.append("removed our guard's #endif; head not adjacent, left alone")
+        else:
+            notes.append("removed our guard's #endif")
+
+    if SWITCH_NEW in src and RESTORE_NEW in src:
+        if src != original:
+            open(path, "w", encoding="utf-8").write(src)
+        print("  susfs.c: credential helpers already __maybe_unused" +
+              ("; " + "; ".join(notes) if notes else ""))
+        return
+
+    if SWITCH_SIG in src:
+        src = src.replace(SWITCH_SIG, SWITCH_NEW, 1)
+        notes.append("susfs_switch_to_ksu_domain -> __maybe_unused")
+    if RESTORE_SIG in src:
+        src = src.replace(RESTORE_SIG, RESTORE_NEW, 1)
+        notes.append("susfs_restore_creds -> __maybe_unused")
+
+    if src == original:
+        print("  susfs.c: credential helpers not present (nothing to do)")
+        return
+
+    open(path, "w", encoding="utf-8").write(src)
+
+    check = open(path, encoding="utf-8").read()
+    if ENDIF in check:
+        die("the config guard is still present after rewrite")
+    for sig in (SWITCH_NEW, RESTORE_NEW):
+        if sig not in check:
+            die(f"{sig} missing after rewrite")
+    print("  susfs.c: " + "; ".join(notes))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/susfs_fixes/susfs_idmap_compat.py b/scripts/susfs_fixes/susfs_idmap_compat.py
new file mode 100644
index 0000000..5ee356c
--- /dev/null
+++ b/scripts/susfs_fixes/susfs_idmap_compat.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""Rewrite fs/susfs.c idmap calls for kernels that predate i_user_ns().
+
+susfs4ksu's fs/susfs.c is written against the newer helper:
+
+    i_uid_into_mnt(i_user_ns(&fi->inode), &fi->inode)
+    i_uid_into_mnt(i_user_ns(inode), inode)
+
+Kernels before ~6.3 pass the mount namespace explicitly and have no i_user_ns(),
+so they fail with:
+
+    error: implicit declaration of function 'i_user_ns' [-Werror]
+    error: incompatible integer to pointer conversion passing 'int' to
+           parameter of type 'struct user_namespace *' [-Werror]
+    make[1]: *** [...: fs/susfs.o] Error 1
+
+Rewrite both call sites to &init_user_ns, which is what the pre-i_user_ns API
+expects. Idempotent; asserts nothing still references i_user_ns.
+
+Done in Python rather than sed on purpose: `&` in a sed replacement expands to
+the whole match, which mangled the file when the rewrite was first attempted.
+
+Usage: susfs_idmap_compat.py <path/to/fs/susfs.c>
+"""
+import pathlib
+import re
+import sys
+
+CALL = re.compile(r'i_uid_into_mnt\(i_user_ns\(([^()]*)\),')
+
+
+def main():
+    if len(sys.argv) != 2:
+        raise SystemExit('usage: susfs_idmap_compat.py <fs/susfs.c>')
+    path = pathlib.Path(sys.argv[1])
+    src = path.read_text()
+    if 'i_user_ns' not in src:
+        print('fs/susfs.c has no i_user_ns reference - nothing to do')
+        return 0
+    out, n = CALL.subn(r'i_uid_into_mnt(&init_user_ns,', src)
+    if n == 0:
+        raise SystemExit('ERROR: i_user_ns present but the expected call shape was not found')
+    path.write_text(out)
+    left = out.count('i_user_ns')
+    if left:
+        raise SystemExit(f'ERROR: {left} i_user_ns reference(s) still present after rewrite')
+    print(f'rewrote {n} i_uid_into_mnt(i_user_ns(...)) call(s) to &init_user_ns')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/scripts/susfs_fixes/susfs_restore_context.py b/scripts/susfs_fixes/susfs_restore_context.py
new file mode 100644
index 0000000..d4fdb12
--- /dev/null
+++ b/scripts/susfs_fixes/susfs_restore_context.py
@@ -0,0 +1,144 @@
+#!/usr/bin/env python3
+"""Re-insert `#include <trace/hooks/*>` context lines a SUSFS hunk expects.
+
+Google keeps dropping `#include <trace/hooks/blk.h>`, `<trace/hooks/fs.h>` and
+`<trace/hooks/mm.h>` from GKI sources while the susfs4ksu patch still lists them
+as hunk context, so `patch` fails hunk #1 of fs/namespace.c / fs/proc/task_mmu.c
+on those sublevels. The includes are context only - SUSFS uses no blk/fs/mm
+trace hook symbols - so restoring the line (and an empty header when the tree no
+longer ships it) makes the hunk apply.
+
+Deliberately narrow: only `<trace/hooks/...>` includes are considered, and lines
+are inserted after the last include that the same hunk lists and the file
+already has. Anything else is left alone - rewriting unrelated includes breaks
+the very context we are trying to restore.
+
+Idempotent. Usage: susfs_restore_context.py <patch> [tree]
+"""
+import pathlib
+import re
+import sys
+
+INCLUDE_RE = re.compile(r'^#include\s+(?P<inc><trace/hooks/[^>]+>)')
+ANY_INCLUDE = re.compile(r'^#include\s+(?P<inc>[<"][^>"]+[>"])')
+
+
+def first_hunk_context_includes(hunk_lines):
+    """Ordered #include lines the first hunk expects to find in the source."""
+    out = []
+    for line in hunk_lines:
+        if line[:1] != ' ':
+            continue
+        m = ANY_INCLUDE.match(line[1:].strip())
+        if m:
+            out.append(m.group('inc'))
+    return out
+
+
+def parse_patch(text):
+    """{path: [include, ...]} for the first hunk of every patched file."""
+    files = {}
+    cur = None
+    hunk = []
+    in_first = False
+
+    def flush():
+        nonlocal hunk, in_first
+        if cur is not None and in_first:
+            incs = first_hunk_context_includes(hunk)
+            if incs:
+                files[cur] = incs
+        hunk = []
+        in_first = False
+
+    for line in text.splitlines():
+        if line.startswith('diff --git '):
+            flush()
+            m = re.match(r'diff --git a/(\S+) b/', line)
+            cur = m.group(1) if m else None
+            continue
+        if line.startswith('@@'):
+            if in_first:
+                flush()
+                cur = None
+                continue
+            in_first = True
+            continue
+        if in_first:
+            hunk.append(line)
+    flush()
+    return files
+
+
+def ensure_stub(tree, inc):
+    """Create an empty placeholder for a context-only trace hook header."""
+    rel = inc.strip('<>')
+    header = tree / 'include' / rel
+    if header.exists():
+        return None
+    header.parent.mkdir(parents=True, exist_ok=True)
+    guard = '_SUSFS_CONTEXT_STUB_' + re.sub(r'\W', '_', rel).upper()
+    header.write_text(
+        f'/* Stub created by GKI_KernelSU_SUSFS.\n'
+        f' * The SUSFS patch lists #include <{rel}> as hunk context only; this\n'
+        f' * GKI sublevel no longer ships the header. No symbols are used. */\n'
+        f'#ifndef {guard}\n#define {guard}\n#endif\n')
+    return header
+
+
+def main():
+    if len(sys.argv) < 2:
+        raise SystemExit('usage: susfs_restore_context.py <patch> [tree]')
+    patch_path = pathlib.Path(sys.argv[1])
+    tree = pathlib.Path(sys.argv[2] if len(sys.argv) > 2 else '.')
+    plan = parse_patch(patch_path.read_text(errors='replace'))
+
+    added, stubbed = [], []
+    for rel, includes in plan.items():
+        if not any(INCLUDE_RE.match('#include ' + i) for i in includes):
+            continue
+        target = tree / rel
+        if not target.exists():
+            continue
+        lines = target.read_text(errors='replace').splitlines(keepends=True)
+        present = [l.strip() for l in lines]
+
+        # Walk the hunk's include sequence in order and keep a cursor in the
+        # file: a missing trace/hooks include is inserted exactly where the
+        # hunk expects it (right after its predecessor), not after whatever
+        # include happens to come last in the file.
+        changed = False
+        cursor = 0
+        for inc in includes:
+            want = f'#include {inc}'
+            try:
+                idx = present.index(want, cursor)
+            except ValueError:
+                idx = None
+            if idx is not None:
+                cursor = idx + 1
+                continue
+            if not INCLUDE_RE.match('#include ' + inc):
+                continue  # only the trace/hooks context class is restored
+            lines.insert(cursor, want + '\n')
+            present.insert(cursor, want)
+            added.append(f'{rel}: {want}')
+            stub = ensure_stub(tree, inc)
+            if stub:
+                stubbed.append(str(stub.relative_to(tree)))
+            cursor += 1
+            changed = True
+        if changed:
+            target.write_text(''.join(lines))
+
+    for a in added:
+        print(f'context restored  {a}')
+    for s in stubbed:
+        print(f'stub header made  {s}')
+    if not added and not stubbed:
+        print('context already complete - nothing to restore')
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
