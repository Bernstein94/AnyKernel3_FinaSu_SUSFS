+-/*
+- * get the objective security ID of a task
+- */
+-static inline u32 task_sid_obj(const struct task_struct *task)
+-{
+-    u32 sid;
+-
+-    rcu_read_lock();
+-    sid = cred_sid(__task_cred(task));
+-    rcu_read_unlock();
+-    return sid;
+-}
