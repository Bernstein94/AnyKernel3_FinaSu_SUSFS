+-static u32 ptrace_parent_sid(void)
+-{
+-    u32 sid = 0;
+-    struct task_struct *tracer;
+-
+-    rcu_read_lock();
+-    tracer = ptrace_parent(current);
+-    if (tracer)
+-        sid = task_sid_obj(tracer);
+-    rcu_read_unlock();
+-
+-    return sid;
+-}
